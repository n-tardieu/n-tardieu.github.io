---
// Habillage des pages annexes d'Eau & Café (confidentialité, assistance) : le
// mini-site de l'app, avec une colonne de texte courant lisible.
import AppShell from '../layouts/AppShell.astro';

interface Props {
	title: string;
	description: string;
}

const { title, description } = Astro.props;
---

<AppShell app="eau-et-cafe" title={title} description={description}>
	<main class="prose">
		<slot />
	</main>
</AppShell>

<style>
	.prose {
		width: min(760px, calc(100% - 32px));
		margin: 0 auto;
	}

	.prose {
		padding: 48px 0 64px;
	}

	.prose :global(h1) {
		font-family: 'Archivo Narrow', 'Archivo', sans-serif;
		font-weight: 700;
		font-size: clamp(38px, 7vw, 60px);
		line-height: 0.95;
		text-transform: uppercase;
		margin: 0 0 12px;
	}

	.prose :global(h2) {
		font-size: 19px;
		margin: 36px 0 8px;
		padding-top: 18px;
		border-top: 1px solid var(--line);
	}

	.prose :global(p),
	.prose :global(li) {
		color: #2a2a27;
	}

	.prose :global(a) {
		color: var(--accent);
	}

	.prose :global(.updated) {
		font-size: 14px;
		color: var(--ink-2);
		margin-bottom: 28px;
	}

	.prose :global(.lang) {
		display: flex;
		gap: 16px;
		font-size: 14px;
		font-weight: 600;
		margin-bottom: 32px;
	}

	.prose :global(hr) {
		border: 0;
		border-top: 2px solid var(--ink);
		margin: 64px 0 48px;
	}


</style>
