---
// « Me soutenir », les étoiles d'abord : cinq étoiles qui se remplissent quand la
// section arrive à l'écran, puis les liens directs vers les formulaires d'avis
// des stores. En second : en parler, et offrir un café quand KOFI_URL est
// renseigné. Monté sur l'accueil et la page à propos.
import { APPS, KOFI_URL, reviewLinks } from '../data/apps';

const rated = APPS.map((app) => ({ app, links: reviewLinks(app) })).filter((r) => r.links.length > 0);
const star = 'M12 2.5l2.9 6.2 6.6.8-4.9 4.6 1.3 6.6L12 17.4l-5.9 3.3 1.3-6.6L2.5 9.5l6.6-.8z';
---

<section class="support wrap" id="soutenir" aria-labelledby="soutenir-titre" data-reveal>
	<div class="stars" aria-hidden="true">
		{
			[0, 1, 2, 3, 4].map((i) => (
				<svg viewBox="0 0 24 24" style={`--i: ${i}`}>
					<path d={star} />
				</svg>
			))
		}
	</div>
	<p class="label">Me soutenir</p>
	<h2 id="soutenir-titre" class="display">Cinq étoiles, deux lignes.</h2>
	<p class="lede">
		Je fais ces apps seul. Une note et un avis sur le store, c’est ce qui m’aide le plus : c’est gratuit, ça prend une
		minute, et ça aide d’autres personnes à les trouver.
	</p>
	<div class="review-btns">
		{
			rated.flatMap(({ app, links }) =>
				links.map((l) => (
					<a href={l.url} target="_blank" rel="noopener">
						Noter {app.name} sur {l.label}
					</a>
				)),
			)
		}
	</div>
	<ul class="more">
		<li><strong>Parles-en</strong> à quelqu’un qui oublie de boire ou qui a besoin de souffler.</li>
		{
			KOFI_URL && (
				<li>
					<strong>
						<a href={KOFI_URL} target="_blank" rel="noopener">
							Offre-moi un café
						</a>
					</strong>{' '}
					sur Ko-fi, si tu veux aller plus loin.
				</li>
			)
		}
	</ul>
</section>

<style>
	.support {
		margin-top: 96px;
		padding: 56px 48px;
		background: #fbfaf6;
		border: 2px solid var(--ink);
		text-align: center;
	}

	.stars {
		display: flex;
		justify-content: center;
		gap: 8px;
		margin-bottom: 24px;
	}

	.stars svg {
		width: clamp(44px, 7vw, 72px);
		height: auto;
		fill: #dad8d0;
		transition:
			fill 0.4s ease calc(var(--i) * 0.15s + 0.3s),
			transform 0.4s ease calc(var(--i) * 0.15s + 0.3s);
	}

	:global(.in) .stars svg,
	:global(html:not(.js)) .stars svg {
		fill: #e8a317;
	}

	:global(.in) .stars svg {
		transform: scale(1.06);
	}

	.label {
		color: var(--ink-2);
	}

	h2 {
		margin: 10px 0 14px;
		font-size: clamp(40px, 6vw, 72px);
	}

	.lede {
		max-width: 34em;
		margin: 0 auto 28px;
		font-size: 19px;
		color: var(--ink-2);
	}

	.review-btns {
		display: flex;
		flex-wrap: wrap;
		justify-content: center;
		gap: 12px;
	}

	.review-btns a {
		padding: 14px 20px;
		background: var(--ink);
		color: var(--paper);
		font-weight: 700;
		text-decoration: none;
		transition: transform 0.2s ease;
	}

	.review-btns a:hover {
		transform: translateY(-2px);
	}

	.more {
		display: flex;
		flex-wrap: wrap;
		justify-content: center;
		gap: 8px 32px;
		margin: 28px 0 0;
		padding: 0;
		list-style: none;
		font-size: 15px;
		color: var(--ink-2);
	}

	.more strong,
	.more a {
		color: var(--ink);
	}

	@media (prefers-reduced-motion: reduce) {
		.stars svg {
			fill: #e8a317;
			transition: none;
		}
	}

	@media (max-width: 560px) {
		.support {
			padding: 36px 20px;
		}

		.review-btns a {
			width: 100%;
		}
	}
</style>
