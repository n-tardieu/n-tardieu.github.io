---
// Habillage des pages annexes de Coheria (confidentialité, assistance) : le
// mini-site de l'app, avec une colonne de texte courant lisible. Pendant
// d'EauCafeShell, aux couleurs et à la typographie de Coheria.
import AppShell from '../layouts/AppShell.astro';

interface Props {
	title: string;
	description: string;
}

const { title, description } = Astro.props;
---

<AppShell app="coheria" title={title} description={description}>
	<main class="prose">
		<slot />
	</main>
</AppShell>

<style>
	.prose {
		width: min(760px, calc(100% - 32px));
		margin: 0 auto;
		padding: 48px 0 64px;
	}

	.prose :global(h1) {
		font-weight: 800;
		font-size: clamp(36px, 6vw, 56px);
		line-height: 1;
		letter-spacing: -0.04em;
		margin: 0 0 12px;
	}

	.prose :global(h2) {
		font-size: 19px;
		letter-spacing: -0.01em;
		margin: 36px 0 8px;
		padding-top: 18px;
		border-top: 1px solid var(--line);
	}

	.prose :global(article) {
		margin: 0;
	}

	.prose :global(p),
	.prose :global(li) {
		color: #2a2d36;
	}

	.prose :global(a) {
		color: var(--accent);
	}

	.prose :global(.updated) {
		font-size: 14px;
		color: var(--ink-2);
		margin-bottom: 28px;
	}

	.prose :global(.lang) {
		display: flex;
		flex-wrap: wrap;
		gap: 16px;
		font-size: 14px;
		font-weight: 600;
		margin-bottom: 32px;
	}

	.prose :global(.lang a[aria-current='true']) {
		color: var(--ink);
	}

	.prose :global(hr) {
		border: 0;
		border-top: 2px solid var(--ink);
		margin: 64px 0 48px;
	}
</style>
