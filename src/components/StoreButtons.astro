---
// Badges officiels App Store et Google Play (versions françaises, fournies par
// Apple et Google, à ne pas modifier). Tant qu'une app n'est pas sur un store,
// on n'affiche pas son badge (règle des deux marques) mais une mention « Bientôt ».
import type { AppEntry } from '../data/apps';

interface Props {
	app: AppEntry;
	class?: string;
}

const { app, class: className } = Astro.props;
const { ios, android } = app.stores;
const soon = [!ios && 'l’App Store', !android && 'Google Play'].filter(Boolean).join(' et ');
---

<div class:list={['store-badges', className]}>
	{
		ios && (
			<a href={ios} target="_blank" rel="noopener" data-store="ios">
				<img src="/badges/app-store-fr.svg" alt="Télécharger dans l’App Store" width="152" height="48" />
			</a>
		)
	}
	{
		android && (
			<a href={android} target="_blank" rel="noopener" data-store="android">
				<img src="/badges/google-play-fr.png" alt="Disponible sur Google Play" width="162" height="48" />
			</a>
		)
	}
	{soon && <p class="soon">Bientôt sur {soon}</p>}
</div>

<style>
	.store-badges {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 12px;
	}

	a {
		display: block;
		border-radius: 9px;
		transition:
			transform 0.2s ease,
			opacity 0.2s ease;
	}

	a:hover {
		transform: translateY(-2px);
	}

	a:focus-visible {
		outline: 2px solid currentColor;
		outline-offset: 3px;
	}

	img {
		display: block;
		width: auto;
		height: 48px;
	}

	.soon {
		margin: 0;
		padding: 12px 16px;
		border: 1.5px dashed currentColor;
		font-size: 15px;
		font-weight: 600;
	}
</style>
