---
import { APPS } from '../data/apps';
import { GUIDES } from '../data/guides';

const tools = GUIDES.filter((g) => g.kind === 'outil');
---

<footer class="site-footer">
	<div class="cols">
		<div>
			<p class="head">Apps</p>
			{APPS.map((a) => <a href={`/${a.slug}`}>{a.name}</a>)}
		</div>
		<div>
			<p class="head">Outils gratuits</p>
			{tools.map((t) => <a href={t.href}>{t.title}</a>)}
		</div>
		<div>
			<p class="head">Le site</p>
			<a href="/guides/">Guides et outils</a>
			<a href="/a-propos/">À propos</a>
			<a href="mailto:nicolas.tardieu.pro@gmail.com">Contact</a>
		</div>
	</div>
	<p class="legal">
		Les contenus de ce site sont des repères de bien-être, pas des avis médicaux. © {new Date().getFullYear()} Nicolas
		Tardieu.
	</p>
</footer>

<style>
	.site-footer {
		width: min(1132px, calc(100% - 32px));
		margin: 96px auto 0;
		padding: 28px 0 40px;
		border-top: 2px solid var(--ink, #0e0e0e);
		font-size: 14px;
	}

	.cols {
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: 24px;
	}

	.cols div {
		display: flex;
		flex-direction: column;
		gap: 6px;
	}

	.head {
		margin: 0 0 4px;
		font-size: 12px;
		font-weight: 700;
		letter-spacing: 0.12em;
		text-transform: uppercase;
	}

	.cols a {
		color: var(--ink-2, #55544f);
		text-decoration: none;
	}

	.cols a:hover {
		color: var(--ink, #0e0e0e);
		text-decoration: underline;
	}

	.legal {
		margin: 32px 0 0;
		font-size: 12px;
		color: var(--ink-2, #55544f);
	}

	@media (max-width: 640px) {
		.cols {
			grid-template-columns: 1fr;
		}
	}
</style>
