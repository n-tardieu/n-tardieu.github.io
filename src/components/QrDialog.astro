---
// QR code en plein écran, pour qu'une personne en face le scanne. Le code est
// généré à la construction (aucun service extérieur). Tout élément portant
// data-qr-open="<id>" ouvre la fenêtre ; Échap, le bouton ou un clic à côté la
// ferment. Boutons « Copier le lien » et, sur téléphone, « Partager ».
import QRCode from 'qrcode';

interface Props {
	id: string;
	url: string;
	title: string;
	caption?: string;
	/** Icône affichée au-dessus du titre (facultatif). */
	icon?: string;
}

const { id, url, title, caption, icon } = Astro.props;
const svg = await QRCode.toString(url, {
	type: 'svg',
	margin: 0,
	errorCorrectionLevel: 'M',
	color: { dark: '#111111', light: '#ffffff' },
});
const shown = url.replace(/^https?:\/\//, '').replace(/\/$/, '');
---

<dialog class="qr-dialog" id={id} aria-labelledby={`${id}-title`}>
	<div class="sheet">
		<button type="button" class="close" data-qr-close aria-label="Fermer">✕</button>
		{icon && <img class="icon" src={icon} alt="" width="56" height="56" />}
		<h2 id={`${id}-title`}>{title}</h2>
		{caption && <p class="caption">{caption}</p>}
		<div class="code" set:html={svg} role="img" aria-label={`QR code vers ${shown}`} />
		<p class="url">{shown}</p>
		<div class="actions">
			<button type="button" data-qr-copy={url}>Copier le lien</button>
			<button type="button" data-qr-share={url} data-qr-title={title} hidden>Partager…</button>
		</div>
	</div>
</dialog>

<script>
	document.addEventListener('click', async (e) => {
		const target = e.target as HTMLElement;
		const opener = target.closest<HTMLElement>('[data-qr-open]');
		if (opener) {
			e.preventDefault();
			(document.getElementById(opener.dataset.qrOpen!) as HTMLDialogElement | null)?.showModal();
			return;
		}
		const dialog = target.closest<HTMLDialogElement>('dialog.qr-dialog');
		// Clic sur le fond (hors de la feuille) ou sur la croix : fermer.
		if (target.matches('dialog.qr-dialog') || target.closest('[data-qr-close]')) {
			(dialog ?? (target as HTMLDialogElement)).close();
			return;
		}
		const copy = target.closest<HTMLButtonElement>('[data-qr-copy]');
		if (copy) {
			await navigator.clipboard.writeText(copy.dataset.qrCopy!);
			copy.textContent = 'Lien copié ✓';
			setTimeout(() => (copy.textContent = 'Copier le lien'), 1800);
			return;
		}
		const share = target.closest<HTMLButtonElement>('[data-qr-share]');
		if (share && navigator.share) {
			await navigator.share({ title: share.dataset.qrTitle, url: share.dataset.qrShare }).catch(() => {});
		}
	});

	// Le partage natif n'existe que sur certains appareils (surtout les téléphones).
	if ('share' in navigator) {
		document.querySelectorAll<HTMLElement>('[data-qr-share]').forEach((b) => (b.hidden = false));
	}
</script>

<style>
	.qr-dialog {
		width: 100%;
		max-width: 100%;
		height: 100%;
		max-height: 100%;
		margin: 0;
		padding: 0;
		border: 0;
		background: transparent;
		color: #111;
	}

	.qr-dialog[open] {
		display: flex;
		align-items: center;
		justify-content: center;
	}

	.qr-dialog::backdrop {
		background: rgba(10, 10, 10, 0.55);
		-webkit-backdrop-filter: blur(6px);
		backdrop-filter: blur(6px);
	}

	.qr-dialog[open] .sheet {
		animation: qr-in 0.28s cubic-bezier(0.2, 0.7, 0.2, 1);
	}

	@keyframes qr-in {
		from {
			opacity: 0;
			transform: scale(0.94);
		}
	}

	.sheet {
		position: relative;
		display: flex;
		flex-direction: column;
		align-items: center;
		width: min(560px, calc(100% - 24px));
		max-height: calc(100% - 24px);
		padding: 40px 28px 28px;
		overflow: auto;
		border-radius: 24px;
		background: #fff;
		text-align: center;
	}

	.close {
		position: absolute;
		top: 12px;
		right: 12px;
		width: 40px;
		height: 40px;
		border: 0;
		border-radius: 50%;
		background: #f1f1f4;
		color: #111;
		font-size: 16px;
		cursor: pointer;
	}

	.icon {
		margin-bottom: 12px;
		border-radius: 14px;
	}

	h2 {
		margin: 0;
		font-family: -apple-system, 'SF Pro Display', system-ui, sans-serif;
		font-size: 24px;
		font-weight: 800;
		letter-spacing: -0.02em;
	}

	.caption {
		margin: 6px 0 0;
		font-size: 15px;
		color: #6e7683;
	}

	.code {
		width: min(78vw, 56vh, 380px);
		aspect-ratio: 1;
		margin: 24px 0 14px;
		padding: 16px;
		border: 1px solid #ececf1;
		border-radius: 16px;
		background: #fff;
	}

	.code :global(svg) {
		display: block;
		width: 100%;
		height: 100%;
	}

	.url {
		margin: 0 0 18px;
		font-size: 14px;
		font-weight: 600;
		color: #6e7683;
		overflow-wrap: anywhere;
	}

	.actions {
		display: flex;
		flex-wrap: wrap;
		justify-content: center;
		gap: 10px;
	}

	.actions button {
		padding: 11px 18px;
		border: 1.5px solid #111;
		border-radius: 999px;
		background: #fff;
		color: #111;
		font: inherit;
		font-size: 15px;
		font-weight: 700;
		cursor: pointer;
	}

	.actions button:last-child:not([hidden]) {
		background: #111;
		color: #fff;
	}
</style>
