---
// « Partager cette page » : un bouton de pied de page qui affiche en grand le QR
// code de la page en cours, pour la montrer à quelqu'un depuis son téléphone.
import QrDialog from './QrDialog.astro';

interface Props {
	class?: string;
}

const url = new URL(Astro.url.pathname, Astro.site).href;
---

<button type="button" class:list={['share-page', Astro.props.class]} data-qr-open="qr-page">
	<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 3h7v7H3zM14 3h7v7h-7zM3 14h7v7H3zM14 14h3v3h-3zM18 18h3v3h-3zM14 18h2M18 14h3" /></svg>
	Partager cette page
</button>
<QrDialog id="qr-page" url={url} title="Partager cette page" caption="Scanne pour l’ouvrir sur ton téléphone." />

<style>
	.share-page {
		display: inline-flex;
		align-items: center;
		gap: 8px;
		padding: 8px 14px;
		border: 1.5px solid currentColor;
		border-radius: 999px;
		background: transparent;
		color: inherit;
		font: inherit;
		font-size: 14px;
		font-weight: 700;
		cursor: pointer;
	}

	.share-page:hover {
		background: var(--ink, #111);
		border-color: var(--ink, #111);
		color: var(--paper, #fff);
	}

	svg {
		width: 16px;
		height: 16px;
		fill: none;
		stroke: currentColor;
		stroke-width: 2;
	}
</style>
