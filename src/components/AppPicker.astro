---
// « Pour quelle app ? » : les icônes se chevauchent, inclinées, et s'écartent au
// survol, comme chez Chris Raroque. Un clic choisit l'app ; SupportPanel écoute
// [data-pick] et met tous les sélecteurs de la section à jour.
interface Props {
	apps: { slug: string; name: string; icon: string }[];
	initial: string;
}

const { apps, initial } = Astro.props;
const current = apps.find((a) => a.slug === initial) ?? apps[0];
---

<div class="picker">
	<span class="picker-label">Pour quelle app ?</span>
	<div class="stack" role="radiogroup" aria-label="Choisir l’app">
		{
			apps.map((d, i) => (
				<button
					type="button"
					role="radio"
					aria-checked={String(d.slug === current.slug)}
					data-pick={d.slug}
					style={`--rot: ${i % 2 ? 4 : -6}deg; --z: ${10 + i}`}
				>
					<img src={d.icon} alt={d.name} width="40" height="40" />
					<span class="tip">{d.name}</span>
				</button>
			))
		}
	</div>
	<span class="picked" data-name>{current.name}</span>
</div>

<style>
	.picker {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 8px 14px;
		margin-bottom: 14px;
	}

	.picker-label {
		font-size: 14px;
		font-weight: 600;
		color: var(--ink-2);
	}

	.stack {
		display: inline-flex;
		padding: 4px 4px 4px 0;
	}

	button {
		position: relative;
		z-index: var(--z);
		padding: 0;
		border: 0;
		background: none;
		cursor: pointer;
		transform: rotate(var(--rot));
		transition:
			transform 0.25s cubic-bezier(0.4, 0, 0.2, 1),
			margin 0.25s cubic-bezier(0.4, 0, 0.2, 1);
	}

	button + button {
		margin-left: -16px;
	}

	.stack:hover button,
	.stack:focus-within button {
		transform: rotate(0);
	}

	.stack:hover button + button,
	.stack:focus-within button + button {
		margin-left: 8px;
	}

	img {
		display: block;
		width: 40px;
		height: 40px;
		border: 1px solid rgba(0, 0, 0, 0.12);
		border-radius: 11px;
		box-shadow: 0 1px 2px rgba(0, 0, 0, 0.08);
		transition: box-shadow 0.2s ease;
	}

	button[aria-checked='true'] img {
		box-shadow:
			0 0 0 2px var(--paper-2, #fbfaf6),
			0 0 0 4px var(--accent, var(--ink));
	}

	.tip {
		position: absolute;
		bottom: calc(100% + 8px);
		left: 50%;
		z-index: 50;
		padding: 4px 10px;
		border-radius: 10px;
		background: rgba(0, 0, 0, 0.85);
		color: #fff;
		font-size: 12px;
		font-weight: 600;
		white-space: nowrap;
		opacity: 0;
		pointer-events: none;
		transform: translateX(-50%);
		transition: opacity 0.15s ease;
	}

	button:hover .tip,
	button:focus-visible .tip {
		opacity: 1;
	}

	.picked {
		font-weight: 700;
	}
</style>
