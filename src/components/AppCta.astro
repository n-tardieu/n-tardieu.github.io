---
// Encart de fin de guide ou d'outil : l'app qui fait la même chose, tous les jours.
import StoreButtons from './StoreButtons.astro';
import { getApp } from '../data/apps';

interface Props {
	app: 'coheria' | 'eau-et-cafe';
	/** Phrase d'accroche propre à la page. */
	pitch?: string;
}

const { app: slug, pitch } = Astro.props;
const app = getApp(slug);
const defaults = {
	coheria: 'Coheria te guide trois fois par jour avec une vague à l’écran, des rappels qui se taisent si tu as déjà respiré, et une série qui pardonne un jour manqué.',
	'eau-et-cafe':
		'Eau & Café note ton eau et ton café en un geste, calcule ton heure limite chaque jour et t’offre une œuvre d’art à chaque ouverture.',
};
---

<aside class:list={['app-cta', `is-${slug}`]}>
	<img src={app.icon} alt="" width="72" height="72" />
	<div class="body">
		<p class="kicker">{app.price} · iPhone et Android</p>
		<p class="name"><a href={`/${slug}`}>{app.name}</a></p>
		<p class="pitch">{pitch ?? defaults[slug]}</p>
		<StoreButtons app={app} />
	</div>
</aside>

<style>
	.app-cta {
		display: grid;
		grid-template-columns: 72px 1fr;
		gap: 20px;
		margin: 48px 0;
		padding: 24px;
		border: 2px solid var(--ink, #0e0e0e);
		background: #fff;
	}

	.is-coheria {
		border-color: #5b4bf5;
		border-radius: 20px;
		background: linear-gradient(180deg, #fce3ce, #fff8f2);
	}

	.is-eau-et-cafe {
		background: #fbfaf6;
	}

	img {
		border-radius: 16px;
	}

	.kicker {
		margin: 0;
		font-size: 12px;
		font-weight: 700;
		letter-spacing: 0.1em;
		text-transform: uppercase;
		color: var(--ink-2, #55544f);
	}

	.name {
		margin: 2px 0 6px;
		font-size: 26px;
		font-weight: 800;
		letter-spacing: -0.02em;
	}

	.name a {
		text-decoration: none;
	}

	.pitch {
		margin: 0 0 18px;
		color: #2a2a27;
	}

	@media (max-width: 520px) {
		.app-cta {
			grid-template-columns: 1fr;
			gap: 12px;
		}

		img {
			width: 56px;
			height: 56px;
		}
	}
</style>
