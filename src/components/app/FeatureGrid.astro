---
// Grille de fonctionnalités secondaires : un titre, une phrase.
interface Props {
	items: { title: string; text: string; badge?: string }[];
}

const { items } = Astro.props;
---

<ul class="fgrid">
	{
		items.map((it, i) => (
			<li data-reveal style={`--d: ${(i % 3) * 0.06}s`}>
				<h3>
					{it.title}
					{it.badge && <span class="badge">{it.badge}</span>}
				</h3>
				<p>{it.text}</p>
			</li>
		))
	}
</ul>

<style>
	.fgrid {
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: 0 40px;
		margin: 0;
		padding: 0;
		list-style: none;
	}

	li {
		padding: 22px 0;
		border-top: 1px solid var(--line);
	}

	h3 {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 8px;
		margin: 0 0 6px;
		font-size: 19px;
		letter-spacing: -0.01em;
	}

	.badge {
		padding: 2px 8px;
		border-radius: var(--radius);
		background: var(--accent);
		color: var(--accent-ink);
		font-size: 11px;
		font-weight: 700;
		letter-spacing: 0.06em;
		text-transform: uppercase;
	}

	:global(.theme-coheria) .badge {
		border-radius: 999px;
	}

	p {
		margin: 0;
		font-size: 16px;
		color: var(--ink-2);
	}

	@media (max-width: 860px) {
		.fgrid {
			grid-template-columns: 1fr;
		}
	}
</style>
