---
// Index des guides et outils, groupés par thème.
import Site from '../../layouts/Site.astro';
import { GUIDES, TOPICS, type Topic } from '../../data/guides';

const topics = Object.keys(TOPICS) as Topic[];
---

<Site
	title="Guides et outils : cohérence cardiaque, caféine, eau"
	description="Calculateurs gratuits et guides sourcés sur la cohérence cardiaque, la caféine et l’hydratation, par le développeur de Coheria et Eau & Café."
>
	<main class="wrap index">
		<p class="label">Guides et outils</p>
		<h1 class="display">Des réponses claires, des calculs transparents.</h1>
		{
			topics.map((topic) => {
				const items = GUIDES.filter((g) => g.topic === topic);
				return (
					items.length > 0 && (
						<section id={topic} aria-labelledby={`t-${topic}`}>
							<h2 id={`t-${topic}`} class="display">{TOPICS[topic]}</h2>
							<ul>
								{items.map((g) => (
									<li>
										<a href={g.href}>
											<span class="label">{g.kind === 'outil' ? 'Outil gratuit' : 'Guide'}</span>
											<strong>{g.title}</strong>
											<span class="sum">{g.summary}</span>
										</a>
									</li>
								))}
							</ul>
						</section>
					)
				);
			})
		}
	</main>
</Site>

<style>
	.index {
		padding-top: 48px;
	}

	h1 {
		max-width: 18ch;
		margin: 12px 0 40px;
		font-size: clamp(44px, 7vw, 88px);
	}

	section {
		margin-top: 56px;
		scroll-margin-top: 24px;
	}

	h2 {
		margin: 0;
		padding-bottom: 12px;
		border-bottom: 2px solid var(--ink);
		font-size: clamp(30px, 4vw, 44px);
	}

	ul {
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: 0 32px;
		margin: 0;
		padding: 0;
		list-style: none;
	}

	a {
		display: flex;
		flex-direction: column;
		gap: 4px;
		height: 100%;
		padding: 20px 0;
		border-bottom: 1px solid var(--line);
		text-decoration: none;
	}

	a .label {
		color: var(--ink-2);
	}

	strong {
		font-size: 19px;
		line-height: 1.25;
	}

	a:hover strong {
		text-decoration: underline;
	}

	.sum {
		font-size: 15px;
		color: var(--ink-2);
	}

	@media (max-width: 860px) {
		ul {
			grid-template-columns: 1fr;
		}
	}
</style>
