---
// Index des guides et outils, groupés par thème, en cartes façon blog.
import Site from '../../layouts/Site.astro';
import GuideGrid from '../../components/GuideGrid.astro';
import { GUIDES, TOPICS, type Topic } from '../../data/guides';

const topics = Object.keys(TOPICS) as Topic[];
// Dans chaque thème, les guides avant les outils.
const order = { guide: 0, outil: 1 };
---

<Site
	title="Guides et outils : cohérence cardiaque, caféine, eau"
	description="Calculateurs gratuits et guides sourcés sur la cohérence cardiaque, la caféine et l’hydratation, par le développeur de Coheria et Eau & Café."
	image="/guides/covers/hokusai-vague.jpg"
>
	<main class="wrap index">
		<p class="label" data-reveal>Guides et outils</p>
		<h1 class="display" data-reveal style="--d: 0.08s">Des réponses claires, des calculs transparents.</h1>
		{
			topics.map((topic) => {
				const items = GUIDES.filter((g) => g.topic === topic).sort((a, b) => order[a.kind] - order[b.kind]);
				return (
					items.length > 0 && (
						<section id={topic} aria-labelledby={`t-${topic}`}>
							<h2 id={`t-${topic}`} class="display" data-reveal>
								{TOPICS[topic]}
							</h2>
							<GuideGrid guides={items} showKind />
						</section>
					)
				);
			})
		}
	</main>
</Site>

<style>
	.index {
		padding-top: 48px;
	}

	h1 {
		max-width: 18ch;
		margin: 12px 0 24px;
		font-size: clamp(44px, 7vw, 88px);
	}

	section {
		margin-top: 72px;
		scroll-margin-top: 24px;
	}

	h2 {
		margin: 0;
		padding-bottom: 12px;
		border-bottom: 2px solid var(--ink);
		font-size: clamp(30px, 4vw, 44px);
	}
</style>
