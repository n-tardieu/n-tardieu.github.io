---
// Le hub : toutes les apps, chacune dans ses propres couleurs.
import Base from '../layouts/Base.astro';
import StoreButtons from '../components/StoreButtons.astro';
import { APPS } from '../data/apps';

const jsonLd = {
	'@context': 'https://schema.org',
	'@type': 'Person',
	name: 'Nicolas Tardieu',
	url: 'https://n-tardieu.github.io',
	jobTitle: 'Éditeur d’applications mobiles',
	sameAs: ['https://github.com/n-tardieu'],
};
---

<Base
	title="Nicolas Tardieu · Applications mobiles"
	description="Coheria, Eau & Café : des applications iPhone et Android simples, sans publicité, qui respectent ta vie privée. Conçues et développées par Nicolas Tardieu."
	image="/apps/coheria/01-home.webp"
	themeColor="#FAF8F4"
	fonts="family=Inter:wght@400;500;600;700;800"
	jsonLd={jsonLd}
>
	<div class="page">
		<header class="wrap intro">
			<p class="eyebrow">Nicolas Tardieu · Éditeur d’applications</p>
			<h1>Des apps simples, pour prendre soin de ses journées.</h1>
			<p class="lede">
				Je conçois et développe des applications mobiles pour iPhone et Android. Peu de réglages, pas de publicité, et
				tes données restent les tiennes.
			</p>
		</header>

		<main class="wrap apps">
			{
				APPS.map((app, i) => (
					<article
						class="app"
						style={`--accent: ${app.accent}; --surface: ${app.surface}; --ink: ${app.ink}; --sb-bg: ${app.accent}; --delay: ${i * 0.12}s`}
					>
						<a href={`/${app.slug}`} class="app-link" aria-label={`Découvrir ${app.name}`} />
						<div class="app-head">
							<img src={app.icon} alt="" width="72" height="72" class="app-icon" />
							<span class="app-arrow" aria-hidden="true">
								→
							</span>
						</div>
						<h2>{app.name}</h2>
						<p>{app.tagline}</p>
						<div class="app-shots" aria-hidden="true">
							{app.preview.map((src) => (
								<img src={src} alt="" loading="lazy" width="660" height="1434" />
							))}
						</div>
						<StoreButtons app={app} class="app-stores" />
					</article>
				))
			}
		</main>

		<footer class="wrap footer">
			<div>
				<p class="eyebrow">Contact</p>
				<a href="mailto:nicolas.tardieu.pro@gmail.com" class="mail">nicolas.tardieu.pro@gmail.com</a>
			</div>
			<a href="https://github.com/n-tardieu" target="_blank" rel="noopener" class="gh">GitHub</a>
		</footer>
	</div>
</Base>

<style>
	.page {
		min-height: 100vh;
		background: #faf8f4;
		color: #141414;
		font-family: 'Inter', system-ui, sans-serif;
		font-size: 17px;
		line-height: 1.55;
	}

	.wrap {
		width: min(1120px, calc(100% - 48px));
		margin: 0 auto;
	}

	.eyebrow {
		margin: 0 0 16px;
		font-size: 13px;
		font-weight: 600;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		color: #77736b;
	}

	.intro {
		padding: 96px 0 56px;
		animation: rise 0.8s ease-out both;
	}

	.intro h1 {
		max-width: 14em;
		margin: 0 0 20px;
		font-size: clamp(40px, 6vw, 76px);
		font-weight: 800;
		line-height: 1;
		letter-spacing: -0.045em;
	}

	.lede {
		max-width: 34em;
		margin: 0;
		font-size: 20px;
		color: #55524c;
	}

	.apps {
		display: grid;
		grid-template-columns: repeat(2, 1fr);
		gap: 24px;
	}

	.app {
		position: relative;
		display: flex;
		flex-direction: column;
		padding: 32px;
		border-radius: 28px;
		border: 1px solid rgba(0, 0, 0, 0.06);
		background: var(--surface);
		color: var(--ink);
		overflow: hidden;
		isolation: isolate;
		animation: rise 0.8s ease-out both;
		animation-delay: calc(0.15s + var(--delay));
		transition: transform 0.3s ease;
	}

	.app:hover {
		transform: translateY(-4px);
	}

	.app-link {
		position: absolute;
		inset: 0;
		z-index: 1;
		border-radius: inherit;
	}

	.app-link:focus-visible {
		outline: 3px solid var(--accent);
		outline-offset: 3px;
	}

	.app-head {
		display: flex;
		justify-content: space-between;
		align-items: flex-start;
	}

	.app-icon {
		border-radius: 18px;
	}

	.app-arrow {
		display: grid;
		place-items: center;
		width: 44px;
		height: 44px;
		border-radius: 50%;
		background: var(--accent);
		color: #fff;
		font-size: 20px;
		transition: transform 0.3s ease;
	}

	.app:hover .app-arrow {
		transform: translateX(4px);
	}

	.app h2 {
		margin: 24px 0 6px;
		font-size: 36px;
		font-weight: 800;
		letter-spacing: -0.035em;
	}

	.app > p {
		margin: 0;
		max-width: 22em;
		font-size: 18px;
		opacity: 0.75;
	}

	.app-shots {
		display: flex;
		justify-content: center;
		gap: 16px;
		margin: 32px -8px 28px;
		height: 300px;
		overflow: hidden;
		mask-image: linear-gradient(180deg, #000 70%, transparent);
	}

	.app-shots img {
		width: 46%;
		height: auto;
		align-self: flex-start;
		border-radius: 14px;
		transition: transform 0.5s ease;
	}

	.app-shots img + img {
		margin-top: 40px;
	}

	.app:hover .app-shots img {
		transform: translateY(-12px);
	}

	.app-stores {
		position: relative;
		z-index: 2;
		margin-top: auto;
	}

	.footer {
		display: flex;
		justify-content: space-between;
		align-items: flex-end;
		gap: 24px;
		margin-top: 96px;
		padding: 32px 0 48px;
		border-top: 1px solid #e4e0d8;
	}

	.footer .eyebrow {
		margin-bottom: 4px;
	}

	.mail,
	.gh {
		color: inherit;
		font-weight: 600;
		text-decoration: none;
		border-bottom: 1px solid currentColor;
	}

	@keyframes rise {
		from {
			opacity: 0;
			transform: translateY(24px);
		}
	}

	@media (max-width: 860px) {
		.apps {
			grid-template-columns: 1fr;
		}
	}

	@media (max-width: 560px) {
		.wrap {
			width: calc(100% - 32px);
		}

		.intro {
			padding: 56px 0 40px;
		}

		.lede {
			font-size: 18px;
		}

		.app {
			padding: 24px;
		}

		.app-shots {
			height: 240px;
		}

		.footer {
			flex-direction: column;
			align-items: flex-start;
		}
	}
</style>
