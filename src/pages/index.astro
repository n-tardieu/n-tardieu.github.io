---
// Le hub, « la collection » : un cadre papier et encre, et chaque app numérotée
// dans une carte compacte à sa propre identité, avec ses badges de stores. Puis les outils gratuits,
// les guides, les principes et l'auteur.
import Site from '../layouts/Site.astro';
import StoreButtons from '../components/StoreButtons.astro';
import { APPS } from '../data/apps';
import { GUIDES } from '../data/guides';

const tools = GUIDES.filter((g) => g.kind === 'outil');
const guides = GUIDES.filter((g) => g.kind === 'guide');

const jsonLd = {
	'@context': 'https://schema.org',
	'@graph': [
		{
			'@type': 'Person',
			'@id': 'https://n-tardieu.github.io/#nicolas',
			name: 'Nicolas Tardieu',
			url: 'https://n-tardieu.github.io/a-propos/',
			jobTitle: 'Développeur d’applications mobiles',
			sameAs: ['https://github.com/n-tardieu'],
		},
		{
			'@type': 'ItemList',
			name: 'Applications de Nicolas Tardieu',
			itemListElement: APPS.map((a, i) => ({
				'@type': 'ListItem',
				position: i + 1,
				url: `https://n-tardieu.github.io/${a.slug}`,
				name: a.name,
			})),
		},
	],
};
---

<Site
	title="Nicolas Tardieu · Apps de bien-être pour iPhone et Android"
	description="Coheria pour la cohérence cardiaque, Eau & Café pour l’eau et la caféine : des apps iPhone et Android sans pub, et des outils gratuits en ligne."
	image="/apps/coheria/01-home.webp"
	jsonLd={jsonLd}
>
	<main>
		<section class="intro wrap">
			<h1 class="display">Des apps qui prennent soin de tes journées.</h1>
			<ul class="facts">
				<li><strong>2</strong> apps</li>
				<li>iPhone &amp; Android</li>
				<li><strong>0</strong> pub</li>
				<li>Tes données restent chez toi</li>
			</ul>
		</section>

		<div id="apps" class="apps wrap">
			{
				APPS.map((app, i) => (
					<article class:list={['app', `is-${app.slug}`]}>
						<a href={`/${app.slug}`} class="app-link" aria-label={`Découvrir ${app.name}`} />
						<header class="app-head">
							<img src={app.icon} alt="" width="56" height="56" class="app-icon" />
							<div>
								<p class="num">N°{String(i + 1).padStart(2, '0')} · {app.category}</p>
								<h2>{app.name}</h2>
							</div>
							<span class="app-arrow" aria-hidden="true">
								→
							</span>
						</header>
						<p class="pitch">{app.tagline}</p>
						<div class="app-shots" aria-hidden="true">
							{app.preview.map((src) => (
								<img src={src} alt="" loading="lazy" width="600" height="998" />
							))}
						</div>
						<StoreButtons app={app} class="app-stores" />
					</article>
				))
			}
		</div>

		<section class="tools wrap" aria-labelledby="outils">
			<div class="head">
				<h2 id="outils" class="display">Outils gratuits</h2>
				<p>Les calculs de mes apps, utilisables ici, sans inscription.</p>
			</div>
			<ol class="rows">
				{
					tools.map((t, i) => (
						<li>
							<a href={t.href}>
								<span class="row-num">{String(i + 1).padStart(2, '0')}</span>
								<strong>{t.title}</strong>
								<span class="row-sum">{t.summary}</span>
								<span class="row-arrow" aria-hidden="true">
									→
								</span>
							</a>
						</li>
					))
				}
			</ol>
		</section>

		<section class="tools wrap" aria-labelledby="guides">
			<div class="head">
				<h2 id="guides" class="display">Guides</h2>
				<p>Des réponses claires et sourcées. <a href="/guides/">Tous les guides →</a></p>
			</div>
			<ul class="cards">
				{
					guides.map((g) => (
						<li>
							<a href={g.href}>
								<strong>{g.title}</strong>
								<span>{g.summary}</span>
							</a>
						</li>
					))
				}
			</ul>
		</section>

		<section class="principles wrap" aria-labelledby="principes">
			<h2 id="principes" class="label">Comment je fais mes apps</h2>
			<div class="cols">
				<div>
					<p class="big display">Sans pub</p>
					<p>Ni bannière ni pistage publicitaire. Une app de bien-être ne devrait pas vendre ton attention.</p>
				</div>
				<div>
					<p class="big display">Chez toi</p>
					<p>Tes données restent sur ton téléphone. Pas de compte obligatoire, aucune donnée revendue.</p>
				</div>
				<div>
					<p class="big display">Gratuit</p>
					<p>L’essentiel est gratuit, pour toujours. Quand une option payante existe, c’est un achat simple et facultatif.</p>
				</div>
			</div>
		</section>

		<section class="author wrap" aria-labelledby="auteur">
			<p class="label">Qui fait ces apps</p>
			<h2 id="auteur" class="display">Nicolas Tardieu, développeur indépendant.</h2>
			<p>
				Je conçois, développe et publie seul mes applications pour iPhone et Android, depuis la France. Chaque fonction
				part d’un besoin simple : respirer un moment, penser à boire, mieux placer son dernier café.
			</p>
			<a href="/a-propos/" class="more">En savoir plus sur moi <span aria-hidden="true">→</span></a>
		</section>
	</main>
</Site>

<style>
	.intro {
		padding: 48px 0 32px;
	}

	.intro h1 {
		max-width: 17ch;
		margin: 0 0 28px;
		font-size: clamp(42px, 6.4vw, 96px);
	}

	.facts {
		display: flex;
		flex-wrap: wrap;
		gap: 8px 0;
		list-style: none;
		margin: 0;
		padding: 0;
		font-size: 15px;
		font-weight: 600;
	}

	.facts li {
		padding: 0 18px;
		border-left: 1px solid var(--line);
	}

	.facts li:first-child {
		padding-left: 0;
		border-left: 0;
	}

	/* Apps : deux cartes côte à côte, chacune dans l'identité de son app */
	.apps {
		display: grid;
		grid-template-columns: repeat(2, 1fr);
		gap: 20px;
	}

	.app {
		position: relative;
		display: flex;
		flex-direction: column;
		padding: 24px 24px 22px;
		overflow: hidden;
		isolation: isolate;
	}

	.app-link {
		position: absolute;
		inset: 0;
		z-index: 1;
	}

	.app-link:focus-visible {
		outline: 3px solid var(--ink);
		outline-offset: 3px;
	}

	.app-head {
		display: flex;
		align-items: center;
		gap: 14px;
	}

	.app-icon {
		border-radius: 14px;
	}

	.app-head div {
		flex: 1;
	}

	.num {
		margin: 0 0 2px;
		font-size: 11px;
		font-weight: 700;
		letter-spacing: 0.12em;
		text-transform: uppercase;
	}

	.app h2 {
		margin: 0;
		font-size: 30px;
		line-height: 1;
	}

	.app-arrow {
		display: grid;
		place-items: center;
		width: 40px;
		height: 40px;
		font-size: 20px;
		transition: transform 0.25s ease;
	}

	.app:hover .app-arrow {
		transform: translateX(4px);
	}

	.pitch {
		margin: 14px 0 0;
		font-size: 17px;
		line-height: 1.45;
	}

	.app-shots {
		display: flex;
		justify-content: center;
		gap: 14px;
		height: 230px;
		margin: 20px -4px 18px;
		overflow: hidden;
		-webkit-mask-image: linear-gradient(180deg, #000 72%, transparent);
		mask-image: linear-gradient(180deg, #000 72%, transparent);
	}

	.app-shots img {
		align-self: flex-start;
		width: 44%;
		height: auto;
		border-radius: 12px;
		transition: transform 0.5s ease;
	}

	.app-shots img + img {
		margin-top: 28px;
	}

	.app:hover .app-shots img {
		transform: translateY(-8px);
	}

	.app-stores {
		position: relative;
		z-index: 2;
		margin-top: auto;
	}

	.is-coheria {
		background: linear-gradient(180deg, #fce3ce, #fdeee1 55%, #fff8f2);
		border-radius: 24px;
		color: #15171c;
		font-family: -apple-system, 'SF Pro Display', 'Helvetica Neue', system-ui, sans-serif;
	}

	.is-coheria h2 {
		font-weight: 800;
		letter-spacing: -0.04em;
	}

	.is-coheria .num {
		color: #5b4bf5;
	}

	.is-coheria .pitch {
		color: #4a4f59;
	}

	.is-coheria .app-arrow {
		border-radius: 50%;
		background: #5b4bf5;
		color: #fff;
	}

	.is-eau-et-cafe {
		background: #fbfaf6;
		border: 2px solid var(--ink);
	}

	.is-eau-et-cafe h2 {
		font-family: var(--narrow);
		font-weight: 700;
		text-transform: uppercase;
	}

	.is-eau-et-cafe .num {
		color: #1b2fd6;
	}

	.is-eau-et-cafe .pitch {
		color: var(--ink-2);
	}

	.is-eau-et-cafe .app-arrow {
		background: #1b2fd6;
		color: #fff;
	}

	/* Outils et guides */
	.tools {
		margin-top: 96px;
	}

	.head {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 24px;
		align-items: end;
		padding-bottom: 14px;
		border-bottom: 2px solid var(--ink);
	}

	.head h2 {
		margin: 0;
		font-size: clamp(36px, 5vw, 60px);
	}

	.head p {
		margin: 0;
		justify-self: end;
		color: var(--ink-2);
	}

	.rows {
		list-style: none;
		margin: 0;
		padding: 0;
	}

	.rows a {
		display: grid;
		grid-template-columns: 64px 1fr 1.2fr 32px;
		gap: 24px;
		align-items: baseline;
		padding: 24px 0;
		border-bottom: 1px solid var(--line);
		text-decoration: none;
	}

	.rows a:hover strong {
		text-decoration: underline;
	}

	.row-num {
		font-family: var(--narrow);
		font-size: 34px;
		font-weight: 700;
		line-height: 1;
	}

	.rows strong {
		font-size: 20px;
		line-height: 1.25;
	}

	.row-sum {
		color: var(--ink-2);
	}

	.row-arrow {
		font-size: 22px;
		transition: transform 0.2s ease;
	}

	.rows a:hover .row-arrow {
		transform: translateX(4px);
	}

	.cards {
		display: grid;
		grid-template-columns: repeat(4, 1fr);
		gap: 0 24px;
		list-style: none;
		margin: 0;
		padding: 0;
	}

	.cards a {
		display: flex;
		flex-direction: column;
		gap: 6px;
		height: 100%;
		padding: 20px 0;
		border-bottom: 1px solid var(--line);
		text-decoration: none;
	}

	.cards strong {
		font-size: 18px;
		line-height: 1.25;
	}

	.cards a:hover strong {
		text-decoration: underline;
	}

	.cards span {
		font-size: 14px;
		color: var(--ink-2);
	}

	/* Principes */
	.principles {
		margin-top: 96px;
		padding: 56px 48px;
		background: var(--ink);
		color: var(--paper);
	}

	.principles .cols {
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: 40px;
		margin-top: 28px;
	}

	.principles .big {
		margin: 0 0 10px;
		font-size: 44px;
	}

	.principles p {
		margin: 0;
		color: rgba(245, 244, 239, 0.75);
	}

	/* Auteur */
	.author {
		margin-top: 96px;
	}

	.author h2 {
		max-width: 22ch;
		margin: 10px 0 16px;
		font-size: clamp(34px, 4.6vw, 54px);
	}

	.author p {
		max-width: 38em;
		font-size: 19px;
	}

	@media (max-width: 960px) {
		.apps {
			grid-template-columns: 1fr;
		}

		.head {
			grid-template-columns: 1fr;
			gap: 8px;
		}

		.head p {
			justify-self: start;
		}

		.rows a {
			grid-template-columns: 48px 1fr 24px;
		}

		.row-sum {
			grid-column: 2;
			grid-row: 2;
		}

		.cards {
			grid-template-columns: 1fr 1fr;
		}

		.principles {
			padding: 40px 24px;
		}

		.principles .cols {
			grid-template-columns: 1fr;
			gap: 28px;
		}
	}

	@media (max-width: 560px) {
		.intro {
			padding: 36px 0 28px;
		}

		.facts li {
			padding: 0 12px;
		}

		.cards {
			grid-template-columns: 1fr;
		}
	}
</style>
