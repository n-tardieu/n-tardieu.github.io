---
import AppShell from '../../layouts/AppShell.astro';
import Plans from '../../components/app/Plans.astro';
import StoreButtons from '../../components/StoreButtons.astro';
import { getApp } from '../../data/apps';

const app = getApp('coheria');

const plans = [
	{
		name: 'Gratuit',
		price: '0 €',
		note: 'Pour pratiquer, à vie.',
		items: [
			'Toutes les séances guidées',
			'Tes propres séances, à ton rythme',
			'Les rappels du matin, du midi et du soir',
			'La série et les jours de gel',
			'Ton ressenti et Mon état sur 30 jours',
			'Les bilans de la semaine et du mois, et leur partage',
			'Une ambiance (forêt) et un repère de souffle (bol)',
		],
	},
	{
		name: 'Coheria Complet',
		price: '7,99 €',
		note: 'Un seul achat, à toi pour toujours.',
		featured: true,
		items: [
			'Tout le gratuit',
			'Toutes les ambiances : pluie, feu, sous l’eau, en plus de la forêt',
			'Tous les repères de souffle : cristal, cloche et triangles, en plus du bol',
			'Les sons à venir, sans autre achat',
		],
	},
];

const faq = [
	{
		q: 'Les séances resteront-elles gratuites ?',
		a: 'Oui. Les séances, les rappels, la série et tout le suivi (Mon état, les bilans) sont gratuits, à vie. Complet ajoute l’ambiance sonore, il ne retire rien au gratuit.',
	},
	{
		q: 'Pourquoi un achat unique plutôt qu’un abonnement ?',
		a: 'Respirer ne devrait pas coûter quelque chose tous les mois. Complet se paie une fois, sans abonnement ni période d’essai, et c’est tout.',
	},
	{
		q: 'Peut-on essayer Complet ?',
		a: 'Il n’y a pas de période d’essai, mais la version gratuite, sans limite de temps, en tient lieu : tu entends déjà la forêt et le bol, et tu peux pratiquer aussi longtemps que tu veux avant de décider.',
	},
	{
		q: 'J’ai changé de téléphone, comment retrouver mon achat ?',
		a: 'Dans les réglages de Coheria, « Restaurer les achats » le retrouve avec le même compte App Store ou Google Play.',
	},
	{
		q: 'Le prix est-il le même partout ?',
		a: 'Le prix affiché ici est celui de la France. Le store affiche le prix exact de ton pays au moment de l’achat.',
	},
];
---

<AppShell
	app="coheria"
	title="Tarifs de Coheria : gratuit, ou Complet à 7,99 €"
	description="Coheria est gratuite pour pratiquer et suivre ta pratique, à vie. Coheria Complet, 7,99 € en un seul achat, sans abonnement, ajoute toutes les ambiances et tous les sons."
>
	<main class="wrap">
		<header class="ap-head" data-reveal>
			<p class="label ap-kicker">Tarifs</p>
			<h1 class="display">Gratuit pour respirer. Complet pour aller plus loin.</h1>
			<p class="ap-lede">Pas d’abonnement, pas de publicité.</p>
		</header>

		<Plans plans={plans} />

		<section class="ap-section note" data-reveal>
			<h2 class="display">Un mot sur le prix</h2>
			<p>
				Je développe Coheria seul. L’essentiel, respirer chaque jour et voir ce que ça change, restera toujours gratuit :
				c’est ce qui compte vraiment. Complet existe pour celles et ceux qui veulent envelopper leur pratique d’une
				ambiance, et il finance le temps que je passe à améliorer l’app. Un seul achat, sans abonnement, parce que je
				n’aime pas l’idée de payer tous les mois pour respirer.
			</p>
			<p class="sign">Nicolas</p>
		</section>

		<section class="ap-section ap-faq">
			<h2 class="display" data-reveal>Questions fréquentes</h2>
			{
				faq.map((f) => (
					<details>
						<summary>{f.q}</summary>
						<p>{f.a}</p>
					</details>
				))
			}
		</section>

		<section class="ap-section" data-reveal>
			<StoreButtons app={app} />
		</section>
	</main>
</AppShell>

<style>
	.note p {
		max-width: 40em;
		font-size: 19px;
		color: var(--ink-2);
	}

	.note .sign {
		font-weight: 800;
		color: var(--ink);
	}
</style>
