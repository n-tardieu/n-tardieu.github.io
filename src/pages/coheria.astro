---
// Vitrine de Coheria, « respire avec la page » : le hero montre l'onde de
// l'écran de séance de l'app (5 s / 5 s) et le visiteur peut lancer une
// minute sur place. Identité de l'app : violet seul, colline pêche, violet
// nuit pour le soir, police système grasse, aucune ombre.
import Base from '../layouts/Base.astro';
import StoreButtons from '../components/StoreButtons.astro';
import BreathWave from '../components/BreathWave.astro';
import { getApp } from '../data/apps';
import { guidesFor } from '../data/guides';

const app = getApp('coheria');
const guides = guidesFor('coherence-cardiaque');

const moments = [
	{ time: '8:00', name: 'Le matin', text: 'Avant que la journée ne s’emballe.' },
	{ time: '12:30', name: 'Le midi', text: 'Une pause entre deux choses.' },
	{ time: '19:00', name: 'Le soir', text: 'Pour redescendre en fin de journée.' },
];

const sessions = [
	{ when: 'Trois fois par jour', name: 'Cohérence cardiaque', meta: ['5 min', '5 s · 5 s'], tone: 'warm', icon: 'heart' },
	{ when: 'Quand tu n’as pas le temps', name: 'Rapide', meta: ['3 min', '5 s · 5 s'], tone: 'teal', icon: 'wind' },
	{ when: 'Le soir', name: 'Avant de dormir', meta: ['10 min', '4 s · 6 s'], tone: 'night', icon: 'moon' },
];

const icons: Record<string, string> = {
	heart: 'M12 20s-7-4.4-7-10a4 4 0 0 1 7-2.6A4 4 0 0 1 19 10c0 5.6-7 10-7 10z',
	wind: 'M3 8h11a3 3 0 1 0-3-3M3 12h15a3 3 0 1 1-3 3M3 16h7',
	moon: 'M20 14.5A8 8 0 1 1 9.5 4a6.5 6.5 0 0 0 10.5 10.5z',
};

const habits = [
	{
		img: '01-home',
		alt: 'L’accueil de Coheria : deux séances sur trois aujourd’hui',
		kicker: 'Trois moments, un anneau',
		title: 'Tu sais où tu en es, d’un coup d’œil.',
		text: 'L’anneau compte tes séances du jour. Une seule suffit à valider ta journée, les trois font la méthode 365. Les rappels du matin, du midi et du soir se taisent si tu as déjà respiré.',
	},
	{
		img: '02-state',
		alt: 'Mon état : la courbe du ressenti sur la semaine',
		kicker: 'Mon état',
		title: 'Vois ce que ça change pour toi.',
		text: 'Après chaque séance, note ton ressenti en un geste. Coheria en tire la courbe de ta semaine et le moment de la journée où tu t’apaises le plus.',
	},
	{
		img: '03-streak',
		alt: 'Le calendrier de la série avec un jour de gel',
		kicker: 'Série et jours de gel',
		title: 'Un jour manqué ne casse rien.',
		text: 'Les jours de gel se gagnent en pratiquant et protègent ta série quand la vie s’accélère. Une régularité qui encourage, sans jamais culpabiliser.',
	},
];

const faq = [
	{
		q: 'Qu’est-ce que la cohérence cardiaque ?',
		a: 'Une pratique de respiration lente et régulière, autour de six respirations par minute : environ cinq secondes d’inspiration et cinq secondes d’expiration. Ce rythme aide le cœur et le souffle à se synchroniser, et beaucoup de gens s’en servent pour redescendre quand la journée s’emballe.',
	},
	{
		q: 'Comment fonctionne l’application Coheria ?',
		a: 'Tu suis une vague à l’écran : elle monte quand tu inspires, descend quand tu expires. Pas de voix, juste un rythme à suivre, avec des ambiances sonores si tu le souhaites. Des rappels t’invitent à pratiquer le matin, le midi et le soir.',
	},
	{
		q: 'Combien de fois par jour pratiquer la cohérence cardiaque ?',
		a: 'La méthode la plus répandue, dite « 365 », propose 3 séances par jour, à 6 respirations par minute, pendant 5 minutes. Dans Coheria, une seule séance suffit déjà à valider ta journée.',
	},
	{
		q: 'L’application de cohérence cardiaque Coheria est-elle gratuite ?',
		a: 'Oui : les séances, les rappels et la série sont gratuits, à vie, sur iPhone, iPad et Android. Coheria Complet, facultatif, ajoute Mon état sur 30 jours, le bilan mensuel et toutes les ambiances sonores.',
	},
	{
		q: 'Faut-il créer un compte ?',
		a: 'Non. Ta pratique reste sur ton téléphone. Si tu veux la retrouver en changeant d’appareil, tu peux te connecter avec Apple ou Google pour la sauvegarder.',
	},
	{
		q: 'Coheria remplace-t-elle un suivi médical ?',
		a: 'Non. Coheria est une application de bien-être, pas un dispositif médical : elle n’a pas vocation à diagnostiquer, traiter ou prévenir une maladie.',
	},
];

const jsonLd = {
	'@context': 'https://schema.org',
	'@graph': [
		{
			'@type': 'MobileApplication',
			name: 'Coheria',
			alternateName: 'Coheria : Cohérence cardiaque',
			operatingSystem: 'iOS, Android',
			applicationCategory: 'HealthApplication',
			description:
				'Application de cohérence cardiaque : respiration guidée par une vague à l’écran, méthode 365, séances de 3 à 10 minutes, rappels et série avec jours de gel.',
			offers: { '@type': 'Offer', price: '0', priceCurrency: 'EUR' },
			author: { '@type': 'Person', name: 'Nicolas Tardieu', url: 'https://n-tardieu.github.io/a-propos/' },
			inLanguage: ['fr', 'en', 'es', 'de'],
			downloadUrl: [app.stores.ios, app.stores.android].filter(Boolean),
			screenshot: habits.map((h) => `https://n-tardieu.github.io/apps/coheria/ecrans/${h.img}.webp`),
		},
		{
			'@type': 'FAQPage',
			mainEntity: faq.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
		},
	],
};
---

<Base
	title="Coheria : application de cohérence cardiaque gratuite"
	description="Coheria guide ta respiration avec une vague à l’écran : méthode 365, séances de 3 à 10 minutes, rappels doux. Gratuite sur iPhone et Android."
	image="/apps/coheria/01-home.webp"
	iosAppId={app.stores.iosId}
	themeColor="#FCE3CE"
	favicon={app.icon}
	jsonLd={jsonLd}
>
	<div class="page">
		<section class="hero">
			<header class="nav wrap">
				<a href="/" class="back">← Nicolas Tardieu</a>
				<span class="brand"><img src={app.icon} alt="" width="28" height="28" />Coheria</span>
			</header>

			<div class="hero-inner wrap">
				<div class="hero-text">
					<p class="kicker">Application de cohérence cardiaque</p>
					<h1>La cohérence cardiaque, <em>cinq minutes à la fois.</em></h1>
					<p class="lede">
						Suis la vague, laisse ton souffle ralentir. Trois pauses par jour, des rappels qui savent se taire, et une
						série qui pardonne un jour manqué.
					</p>
					<StoreButtons app={app} />
					<p class="note">Gratuit · iPhone, iPad et Android · Sans compte obligatoire</p>
				</div>

				<div id="respirer" class="breath" data-breath>
					<BreathWave />
					<div class="controls">
						<button type="button" class="try" data-start>Respirer une minute ici</button>
						<p class="count" data-count hidden>1:00</p>
						<div class="done" data-done hidden>
							<p><strong>Une minute de cohérence cardiaque, c’est fait.</strong></p>
							<p>Avec Coheria, c’est cinq minutes, trois fois par jour.</p>
							<button type="button" class="again" data-start>Recommencer</button>
						</div>
					</div>
				</div>
			</div>
			<svg class="hill" viewBox="0 0 1440 120" preserveAspectRatio="none" aria-hidden="true">
				<path d="M0 120V60C240 10 480 0 720 20s480 60 720 30v70z" fill="currentColor"></path>
			</svg>
		</section>

		<main>
			<section class="method wrap" aria-labelledby="method">
				<p class="kicker">La méthode 365</p>
				<h2 id="method">3 fois par jour. 6 respirations par minute. 5 minutes.</h2>
				<ol class="day">
					{
						moments.map((m) => (
							<li>
								<span class="dot" />
								<span class="time">{m.time}</span>
								<strong>{m.name}</strong>
								<span>{m.text}</span>
							</li>
						))
					}
				</ol>
				<p class="method-text">
					Coheria est construite autour de ce rythme, et tu déplaces les rappels selon ta journée.
					<a href="/coherence-cardiaque/methode-365/">La méthode 365 expliquée</a>
				</p>
			</section>

			<section class="sessions wrap" aria-labelledby="sessions">
				<p class="kicker">Une séance pour chaque moment</p>
				<h2 id="sessions">Prête en un geste.</h2>
				<ul class="session-list">
					{
						sessions.map((s) => (
							<li class={`tone-${s.tone}`}>
								<span class="session-icon">
									<svg viewBox="0 0 24 24" aria-hidden="true">
										<path d={icons[s.icon]} fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
									</svg>
								</span>
								<span class="session-when">{s.when}</span>
								<h3>{s.name}</h3>
								<span class="chips">{s.meta.map((m) => <span>{m}</span>)}</span>
							</li>
						))
					}
				</ul>
				<p class="sessions-note">
					Et tes propres séances : ton inspiration, ta pause, ton expiration, ta durée. Avec une ambiance (forêt, pluie fine,
					feu de cheminée, calme sous-marin) ou en silence.
				</p>
			</section>

			<section class="habits wrap" aria-label="Ce qui aide à tenir">
				{
					habits.map((h, i) => (
						<article class:list={['habit', { flip: i % 2 === 1 }]}>
							<div class="habit-shot">
								<img src={`/apps/coheria/ecrans/${h.img}.webp`} alt={h.alt} width="600" height="998" loading="lazy" />
							</div>
							<div class="habit-text">
								<p class="kicker">{h.kicker}</p>
								<h2>{h.title}</h2>
								<p>{h.text}</p>
							</div>
						</article>
					))
				}
			</section>

			<section class="night">
				<div class="wrap night-inner">
					<div>
						<p class="kicker">Gratuit pour respirer</p>
						<h2>L’essentiel ne coûte rien, <em>pour toujours.</em></h2>
						<p class="night-lede">Pas d’abonnement pour respirer, pas de publicité, et ta pratique reste sur ton téléphone.</p>
					</div>
					<div>
						<ul>
							<li>Les séances guidées : cohérence, rapide, avant de dormir</li>
							<li>Tes propres séances</li>
							<li>Les rappels doux</li>
							<li>La série et les jours de gel</li>
						</ul>
						<p class="night-note">
							Coheria Complet, facultatif, ajoute Mon état sur 30 jours, le bilan mensuel et toutes les ambiances sonores.
						</p>
					</div>
				</div>
			</section>

			<section class="faq wrap" aria-labelledby="faq">
				<h2 id="faq">Questions fréquentes</h2>
				{
					faq.map((f) => (
						<details>
							<summary>{f.q}</summary>
							<p>{f.a}</p>
						</details>
					))
				}
				{
					guides.length > 0 && (
						<div class="guides">
							<p class="kicker">Pour aller plus loin</p>
							<ul>
								{guides.map((g) => (
									<li>
										<a href={g.href}>{g.title} →</a>
									</li>
								))}
							</ul>
						</div>
					)
				}
			</section>

			<section class="cta">
				<div class="wrap cta-inner">
					<img src={app.icon} alt="" width="88" height="88" />
					<h2>Prends cinq minutes.<br />Ton corps te remerciera.</h2>
					<StoreButtons app={app} class="cta-stores" />
				</div>
			</section>
		</main>

		<footer class="footer wrap">
			<p>
				Coheria est une application de bien-être et n’est pas un dispositif médical. Contact :
				<a href="mailto:coheria.contact@gmail.com">coheria.contact@gmail.com</a>
			</p>
			<nav>
				<a href={app.privacy}>Confidentialité</a>
				<a href={app.support}>Assistance</a>
				<a href="/">Toutes les apps</a>
			</nav>
		</footer>
	</div>
</Base>

<script>
	// Une minute guidée : on relance l'onde depuis le début d'une inspiration
	// pour que le mot et la bille démarrent ensemble, puis on décompte.
	const root = document.querySelector<HTMLElement>('[data-breath]');
	if (root) {
		const wave = root.querySelector<HTMLElement>('[data-wave]')!;
		const count = root.querySelector<HTMLElement>('[data-count]')!;
		const done = root.querySelector<HTMLElement>('[data-done]')!;
		const start = root.querySelector<HTMLElement>('.try')!;
		const DURATION = 60;
		let timer = 0;

		const run = () => {
			clearInterval(timer);
			wave.classList.remove('is-live');
			void wave.offsetWidth;
			wave.classList.add('is-live');
			start.hidden = true;
			done.hidden = true;
			count.hidden = false;
			const t0 = Date.now();
			const tick = () => {
				const left = DURATION - Math.floor((Date.now() - t0) / 1000);
				if (left <= 0) {
					clearInterval(timer);
					count.hidden = true;
					done.hidden = false;
					return;
				}
				count.textContent = left === 60 ? '1:00' : `0:${String(left).padStart(2, '0')}`;
			};
			tick();
			timer = window.setInterval(tick, 250);
		};

		root.querySelectorAll('[data-start]').forEach((b) => b.addEventListener('click', run));
	}
</script>

<style>
	.page {
		--bg: #ffffff;
		--hero-top: #fce3ce;
		--hero-mid: #fdeee1;
		--hero-bottom: #fff8f2;
		--card: #f5f5fa;
		--text: #15171c;
		--text-soft: #6e7683;
		--primary: #5b4bf5;
		--primary-soft: #ebe9ff;
		--line: #efeff3;

		min-height: 100vh;
		background: var(--bg);
		color: var(--text);
		font-family: -apple-system, 'SF Pro Display', 'SF Pro Text', 'Helvetica Neue', system-ui, sans-serif;
		font-size: 17px;
		line-height: 1.55;
	}

	.wrap {
		width: min(1120px, calc(100% - 48px));
		margin: 0 auto;
	}

	a {
		color: inherit;
	}

	h1,
	h2,
	h3 {
		margin: 0;
		font-weight: 800;
		letter-spacing: -0.03em;
	}

	h1 em,
	h2 em {
		font-style: normal;
		color: var(--primary);
	}

	.kicker {
		margin: 0 0 12px;
		font-size: 12px;
		font-weight: 800;
		letter-spacing: 0.12em;
		text-transform: uppercase;
		color: var(--primary);
	}

	/* Hero */
	.hero {
		position: relative;
		background: linear-gradient(180deg, var(--hero-top), var(--hero-mid) 55%, var(--hero-bottom));
		color: var(--bg);
		overflow: hidden;
	}

	.nav {
		display: flex;
		justify-content: space-between;
		align-items: center;
		padding: 22px 0;
		color: var(--text);
	}

	.back {
		font-size: 14px;
		font-weight: 600;
		text-decoration: none;
		color: var(--text-soft);
	}

	.back:hover {
		color: var(--text);
	}

	.brand {
		display: flex;
		align-items: center;
		gap: 10px;
		font-size: 18px;
		font-weight: 800;
		letter-spacing: -0.02em;
	}

	.brand img {
		border-radius: 8px;
	}

	.hero-inner {
		display: grid;
		grid-template-columns: 1.1fr 0.9fr;
		gap: 48px;
		align-items: center;
		padding: 40px 0 130px;
		color: var(--text);
	}

	.hero h1 {
		margin-bottom: 24px;
		font-size: clamp(42px, 6vw, 80px);
		line-height: 0.98;
		letter-spacing: -0.045em;
	}

	.lede {
		max-width: 30em;
		margin: 0 0 32px;
		font-size: 20px;
		color: #4a4f59;
	}

	.note {
		margin: 18px 0 0;
		font-size: 14px;
		font-weight: 600;
		color: var(--text-soft);
	}

	.hill {
		position: absolute;
		left: 0;
		bottom: -1px;
		width: 100%;
		height: 90px;
	}

	/* Onde de respiration */
	.breath {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 12px;
		width: 100%;
		scroll-margin-top: 24px;
	}

	.controls {
		min-height: 96px;
		text-align: center;
	}

	.try,
	.again {
		padding: 12px 22px;
		border: 1.5px solid var(--primary);
		border-radius: 999px;
		background: rgba(255, 255, 255, 0.6);
		color: var(--primary);
		font: inherit;
		font-size: 16px;
		font-weight: 700;
		cursor: pointer;
		transition: background 0.2s ease;
	}

	.try:hover,
	.again:hover {
		background: #fff;
	}

	.try:focus-visible,
	.again:focus-visible {
		outline: 2px solid var(--primary);
		outline-offset: 3px;
	}

	.count {
		margin: 0;
		font-size: 15px;
		font-weight: 600;
		font-variant-numeric: tabular-nums;
		color: var(--text-soft);
	}

	.done p {
		margin: 0 0 4px;
	}

	.done .again {
		margin-top: 12px;
	}

	/* Méthode 365 */
	.method {
		padding: 64px 0 24px;
		text-align: center;
	}

	.method h2,
	.sessions h2,
	.night h2,
	.faq h2 {
		font-size: clamp(32px, 4.4vw, 52px);
		line-height: 1.05;
	}

	.method h2 {
		max-width: 18em;
		margin: 0 auto;
	}

	.day {
		position: relative;
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		max-width: 900px;
		margin: 56px auto 32px;
		padding: 0;
		list-style: none;
	}

	.day::before {
		content: '';
		position: absolute;
		top: 9px;
		left: 16.6%;
		right: 16.6%;
		height: 2px;
		background: linear-gradient(90deg, var(--hero-top), var(--primary), #211c4a);
	}

	.day li {
		position: relative;
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 2px;
		padding: 0 12px;
	}

	.dot {
		width: 20px;
		height: 20px;
		margin-bottom: 16px;
		border-radius: 50%;
		background: var(--primary);
		box-sizing: border-box;
		border: 5px solid var(--primary-soft);
	}

	.time {
		font-size: clamp(40px, 5vw, 56px);
		font-weight: 800;
		letter-spacing: -0.04em;
		line-height: 1;
		font-variant-numeric: tabular-nums;
		color: var(--primary);
	}

	.day strong {
		margin-top: 8px;
		font-size: 18px;
	}

	.day li > span:last-child {
		color: var(--text-soft);
	}

	.method-text {
		max-width: 34em;
		margin: 0 auto;
		color: var(--text-soft);
	}

	.method-text a {
		display: inline-block;
		margin-left: 4px;
		font-weight: 700;
		color: var(--primary);
	}

	/* Séances */
	.sessions {
		padding-top: 96px;
	}

	.session-list {
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: 16px;
		margin: 32px 0 0;
		padding: 0;
		list-style: none;
	}

	.session-list li {
		display: flex;
		flex-direction: column;
		gap: 6px;
		min-height: 220px;
		padding: 24px;
		border-radius: 22px;
		background: #1a1a21;
		color: #f3f3f6;
	}

	.session-icon {
		display: grid;
		place-items: center;
		width: 52px;
		height: 52px;
		margin-bottom: auto;
		border-radius: 14px;
		color: #fff;
	}

	.session-icon svg {
		width: 26px;
		height: 26px;
	}

	.tone-warm .session-icon {
		background: #e98a3c;
	}

	.tone-teal .session-icon {
		background: #2f8b99;
	}

	.tone-night .session-icon {
		background: #4b4794;
	}

	.session-when {
		margin-top: 28px;
		font-size: 11px;
		font-weight: 800;
		letter-spacing: 0.12em;
		text-transform: uppercase;
		color: #9aa0ac;
	}

	.session-list h3 {
		font-size: 24px;
	}

	.chips {
		display: flex;
		gap: 6px;
		margin-top: 6px;
	}

	.chips span {
		padding: 3px 10px;
		border-radius: 999px;
		background: rgba(255, 255, 255, 0.09);
		font-size: 13px;
		font-weight: 600;
	}

	.sessions-note {
		max-width: 40em;
		margin: 20px 0 0;
		color: var(--text-soft);
	}

	/* Ce qui aide à tenir */
	.habits {
		display: grid;
		gap: 96px;
		padding-top: 112px;
	}

	.habit {
		display: grid;
		grid-template-columns: 0.9fr 1.1fr;
		gap: 64px;
		align-items: center;
	}

	.habit.flip .habit-shot {
		order: 2;
	}

	.habit-shot {
		justify-self: center;
		width: min(380px, 100%);
		border-radius: 28px;
		overflow: hidden;
		background: var(--card);
	}

	.habit-shot img {
		width: 100%;
		height: auto;
