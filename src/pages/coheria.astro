---
// Vitrine de Coheria, aux couleurs de l'app : violet, colline pêche, police
// système en gras serré, aucune ombre. Le cercle du hero respire au rythme de
// la séance de référence (5 s inspire, 5 s expire, six respirations par minute).
import Base from '../layouts/Base.astro';
import StoreButtons from '../components/StoreButtons.astro';
import { getApp } from '../data/apps';

const app = getApp('coheria');

const sessions = [
	{ when: 'Trois fois par jour', name: 'Cohérence cardiaque', meta: ['5 min', '5 s · 5 s'], tone: 'warm', icon: 'heart' },
	{ when: 'Quand tu n’as pas le temps', name: 'Rapide', meta: ['3 min', '4 s · 6 s'], tone: 'teal', icon: 'wind' },
	{ when: 'Le soir', name: 'Avant de dormir', meta: ['10 min', '4 s · 6 s'], tone: 'night', icon: 'moon' },
];

const features = [
	{ title: 'Ton ressenti, en un geste', text: 'Après chaque séance, une touche suffit. Coheria en tire la courbe de ta semaine et le moment où tu t’apaises le plus.' },
	{ title: 'Une série qui pardonne', text: 'Une séance valide ta journée. Les jours de gel, gagnés en pratiquant, protègent ta série quand la vie s’accélère.' },
	{ title: 'Des rappels qui savent se taire', text: 'Matin, midi et soir, à tes heures. Si tu as déjà respiré, le rappel ne sonne pas.' },
	{ title: 'Des sons qui posent l’ambiance', text: 'Forêt, pluie fine, feu de cheminée, calme sous-marin, ou le silence complet. Pas de voix, juste un rythme à suivre.' },
	{ title: 'Tes propres séances', text: 'Choisis ton inspiration, ta pause, ton expiration et ta durée. Chaque séance garde ses réglages.' },
	{ title: 'Trois thèmes', text: 'Aurore pour la journée, Pur pour la clarté, Nuit pour la pratique du soir.' },
];

const shots = [
	{ file: '01-home', alt: 'Accueil : les séances du jour' },
	{ file: '02-state', alt: 'Mon état : le ressenti de la semaine' },
	{ file: '03-streak', alt: 'La série et les jours de gel' },
	{ file: '04-catalog', alt: 'Les séances proposées' },
	{ file: '05-free', alt: 'L’essentiel, gratuit pour toujours' },
];

const faq = [
	{
		q: 'Qu’est-ce que la cohérence cardiaque ?',
		a: 'C’est une pratique de respiration lente et régulière, autour de six respirations par minute : environ cinq secondes d’inspiration, cinq secondes d’expiration. Ce rythme aide le cœur et le souffle à se synchroniser, et beaucoup de gens l’utilisent pour redescendre du stress.',
	},
	{
		q: 'Combien de fois par jour faut-il pratiquer ?',
		a: 'La méthode la plus connue, dite « 365 », propose 3 séances par jour, à 6 respirations par minute, pendant 5 minutes. Coheria est construite autour de ce rythme, mais une seule séance suffit à valider ta journée.',
	},
	{
		q: 'Coheria est-elle gratuite ?',
		a: 'Oui : les séances, les rappels et la série sont gratuits, à vie. Coheria Complet, facultatif, ajoute Mon état sur 30 jours, le bilan mensuel et toutes les ambiances sonores.',
	},
	{
		q: 'Faut-il créer un compte ?',
		a: 'Non. Ta pratique reste sur ton téléphone. Si tu veux la retrouver en changeant d’appareil, tu peux te connecter avec Apple ou Google pour la sauvegarder.',
	},
	{
		q: 'Coheria remplace-t-elle un suivi médical ?',
		a: 'Non. Coheria est une application de bien-être, pas un dispositif médical : elle n’a pas vocation à diagnostiquer, traiter ou prévenir une maladie.',
	},
];

const jsonLd = {
	'@context': 'https://schema.org',
	'@graph': [
		{
			'@type': 'MobileApplication',
			name: app.name,
			operatingSystem: 'iOS, Android',
			applicationCategory: 'HealthApplication',
			description:
				'Application de cohérence cardiaque : respiration guidée à l’écran, méthode 365, rappels, série et ressenti après chaque séance.',
			offers: { '@type': 'Offer', price: '0', priceCurrency: 'EUR' },
			author: { '@type': 'Person', name: 'Nicolas Tardieu' },
			inLanguage: ['fr', 'en', 'es', 'de'],
			downloadUrl: [app.stores.ios, app.stores.android].filter(Boolean),
		},
		{
			'@type': 'FAQPage',
			mainEntity: faq.map((f) => ({
				'@type': 'Question',
				name: f.q,
				acceptedAnswer: { '@type': 'Answer', text: f.a },
			})),
		},
	],
};

const icons: Record<string, string> = {
	heart: 'M12 20s-7-4.4-7-10a4 4 0 0 1 7-2.6A4 4 0 0 1 19 10c0 5.6-7 10-7 10z',
	wind: 'M3 8h11a3 3 0 1 0-3-3M3 12h15a3 3 0 1 1-3 3M3 16h7',
	moon: 'M20 14.5A8 8 0 1 1 9.5 4a6.5 6.5 0 0 0 10.5 10.5z',
};
---

<Base
	title="Coheria : cohérence cardiaque, respiration anti-stress"
	description="Respire en cinq minutes avec Coheria : cohérence cardiaque guidée à l’écran, méthode 365, rappels doux et une série qui pardonne. Gratuit sur iPhone et Android."
	image="/apps/coheria/01-home.webp"
	iosAppId={app.stores.iosId}
	themeColor="#FCE3CE"
	favicon={app.icon}
	jsonLd={jsonLd}
>
	<div class="page">
		<section class="hero">
			<header class="nav wrap">
				<a href="/" class="back">← Nicolas Tardieu</a>
				<span class="brand"><img src={app.icon} alt="" width="28" height="28" />Coheria</span>
			</header>

			<div class="hero-inner wrap">
				<div class="hero-text">
					<p class="kicker">Cohérence cardiaque</p>
					<h1>Un peu chaque jour, <em>ça change tout.</em></h1>
					<p class="lede">
						Suis la vague à l’écran, laisse ton souffle ralentir. Cinq minutes suffisent pour redescendre, avant une
						réunion, après une longue journée ou avant de dormir.
					</p>
					<StoreButtons app={app} />
					<p class="note">Gratuit pour pratiquer · iPhone, iPad et Android</p>
				</div>

				<div class="breath" aria-hidden="true">
					<div class="ring r3"></div>
					<div class="ring r2"></div>
					<div class="orb"></div>
					<p class="phase">
						<span class="in">Inspire</span>
						<span class="out">Expire</span>
					</p>
				</div>
			</div>
			<svg class="hill" viewBox="0 0 1440 120" preserveAspectRatio="none" aria-hidden="true">
				<path d="M0 120V60C240 10 480 0 720 20s480 60 720 30v70z" fill="currentColor"></path>
			</svg>
		</section>

		<main>
			<section class="method wrap" aria-labelledby="method">
				<p class="kicker">La méthode 365</p>
				<h2 id="method">Trois chiffres, une habitude.</h2>
				<div class="figures">
					<div><strong>3</strong><span>séances par jour</span></div>
					<div><strong>6</strong><span>respirations par minute</span></div>
					<div><strong>5</strong><span>minutes chacune</span></div>
				</div>
				<p class="method-text">
					Coheria est pensée autour de ce rythme et le rend facile à tenir, sans jamais culpabiliser : une seule séance
					valide déjà ta journée.
				</p>
			</section>

			<section class="shots" aria-label="Captures d’écran">
				<div class="shots-track">
					{
						shots.map((s) => (
							<img src={`/apps/coheria/${s.file}.webp`} alt={s.alt} width="660" height="1434" loading="lazy" />
						))
					}
				</div>
			</section>

			<section class="sessions wrap" aria-labelledby="sessions">
				<p class="kicker">Une séance pour chaque moment</p>
				<h2 id="sessions">Le matin, le midi, <em>avant de dormir.</em></h2>
				<ul class="session-list">
					{
						sessions.map((s) => (
							<li class={`tone-${s.tone}`}>
								<span class="session-icon">
									<svg viewBox="0 0 24 24" aria-hidden="true">
										<path
											d={icons[s.icon]}
											fill="none"
											stroke="currentColor"
											stroke-width="2"
											stroke-linecap="round"
											stroke-linejoin="round"
										/>
									</svg>
								</span>
								<span class="session-when">{s.when}</span>
								<h3>{s.name}</h3>
								<span class="chips">
									{s.meta.map((m) => (
										<span>{m}</span>
									))}
								</span>
							</li>
						))
					}
				</ul>
			</section>

			<section class="features wrap" aria-label="Fonctionnalités">
				{
					features.map((f) => (
						<article>
							<h3>{f.title}</h3>
							<p>{f.text}</p>
						</article>
					))
				}
			</section>

			<section class="free">
				<div class="wrap free-inner">
					<div>
						<p class="kicker">Sans abonnement pour respirer</p>
						<h2>L’essentiel, <em>gratuit pour toujours.</em></h2>
					</div>
					<div>
						<ul>
							<li>Les séances guidées : cohérence, rapide, sommeil</li>
							<li>Les rappels doux</li>
							<li>La série et les jours de gel</li>
						</ul>
						<p class="free-note">
							Coheria Complet, facultatif, ajoute Mon état sur 30 jours, le bilan mensuel et toutes les ambiances
							sonores.
						</p>
					</div>
				</div>
			</section>

			<section class="faq wrap" aria-labelledby="faq">
				<h2 id="faq">Questions fréquentes</h2>
				{
					faq.map((f) => (
						<details>
							<summary>{f.q}</summary>
							<p>{f.a}</p>
						</details>
					))
				}
			</section>

			<section class="cta">
				<div class="wrap cta-inner">
					<img src={app.icon} alt="" width="88" height="88" />
					<h2>Prends cinq minutes.<br />Ton corps te remerciera.</h2>
					<StoreButtons app={app} class="cta-stores" />
				</div>
			</section>
		</main>

		<footer class="footer wrap">
			<p>
				Coheria est une application de bien-être et n’est pas un dispositif médical. Contact :
				<a href="mailto:coheria.contact@gmail.com">coheria.contact@gmail.com</a>
			</p>
			<nav>
				<a href={app.privacy}>Confidentialité</a>
				<a href={app.support}>Assistance</a>
				<a href="/">Toutes les apps</a>
			</nav>
		</footer>
	</div>
</Base>

<style>
	.page {
		--bg: #ffffff;
		--hero-top: #fce3ce;
		--hero-mid: #fdeee1;
		--hero-bottom: #fff8f2;
		--card: #f5f5fa;
		--card-accent: #ebe9ff;
		--text: #15171c;
		--text-soft: #6e7683;
		--primary: #5b4bf5;
		--primary-soft: #ebe9ff;
		--flame: #f97316;
		--line: #efeff3;
		--night: #0e0b24;

		--sb-bg: var(--primary);
		--sb-fg: #fff;
		--sb-radius: 16px;

		min-height: 100vh;
		background: var(--bg);
		color: var(--text);
		font-family: -apple-system, 'SF Pro Display', 'SF Pro Text', 'Helvetica Neue', system-ui, sans-serif;
		font-size: 17px;
		line-height: 1.55;
	}

	.wrap {
		width: min(1120px, calc(100% - 48px));
		margin: 0 auto;
	}

	a {
		color: inherit;
	}

	h1,
	h2,
	h3 {
		font-weight: 800;
		letter-spacing: -0.03em;
		margin: 0;
	}

	h1 em,
	h2 em {
		font-style: normal;
		color: var(--primary);
	}

	.kicker {
		margin: 0 0 12px;
		font-size: 12px;
		font-weight: 800;
		letter-spacing: 0.12em;
		text-transform: uppercase;
		color: var(--primary);
	}

	/* Hero */
	.hero {
		position: relative;
		background: linear-gradient(180deg, var(--hero-top), var(--hero-mid) 55%, var(--hero-bottom));
		color: var(--bg);
		overflow: hidden;
	}

	.nav {
		display: flex;
		justify-content: space-between;
		align-items: center;
		padding: 22px 0;
		color: var(--text);
	}

	.back {
		font-size: 14px;
		font-weight: 600;
		text-decoration: none;
		color: var(--text-soft);
	}

	.back:hover {
		color: var(--text);
	}

	.brand {
		display: flex;
		align-items: center;
		gap: 10px;
		font-weight: 800;
		font-size: 18px;
		letter-spacing: -0.02em;
	}

	.brand img {
		border-radius: 8px;
	}

	.hero-inner {
		display: grid;
		grid-template-columns: 1.15fr 0.85fr;
		gap: 48px;
		align-items: center;
		padding: 48px 0 140px;
		color: var(--text);
	}

	.hero h1 {
		font-size: clamp(44px, 6.4vw, 84px);
		line-height: 0.98;
		letter-spacing: -0.045em;
		margin-bottom: 24px;
	}

	.hero h1 em {
		color: var(--flame);
	}

	.lede {
		font-size: 20px;
		color: #4a4f59;
		max-width: 30em;
		margin: 0 0 32px;
	}

	.note {
		margin: 18px 0 0;
		font-size: 14px;
		font-weight: 600;
		color: var(--text-soft);
	}

	.hill {
		position: absolute;
		left: 0;
		bottom: -1px;
		width: 100%;
		height: 90px;
	}

	/* Cercle qui respire : 10 s par cycle = 6 respirations par minute */
	.breath {
		position: relative;
		display: grid;
		place-items: center;
		width: min(420px, 80vw);
		aspect-ratio: 1;
		justify-self: center;
	}

	.orb,
	.ring {
		grid-area: 1 / 1;
		border-radius: 50%;
	}

	.orb {
		width: 62%;
		aspect-ratio: 1;
		background: radial-gradient(circle at 35% 30%, #8a7dff, var(--primary) 60%, #4334d6);
		animation: breathe 10s ease-in-out infinite;
	}

	.ring {
		border: 2px solid rgba(91, 75, 245, 0.18);
		animation: breathe 10s ease-in-out infinite;
	}

	.r2 {
		width: 80%;
		aspect-ratio: 1;
		animation-delay: 0.25s;
	}

	.r3 {
		width: 100%;
		aspect-ratio: 1;
		border-color: rgba(91, 75, 245, 0.1);
		animation-delay: 0.5s;
	}

	@keyframes breathe {
		0%,
		100% {
			transform: scale(0.72);
		}
		50% {
			transform: scale(1);
		}
	}

	.phase {
		grid-area: 1 / 1;
		position: relative;
		margin: 0;
		color: #fff;
		font-size: 22px;
		font-weight: 800;
		letter-spacing: -0.01em;
	}

	.phase span {
		display: block;
		text-align: center;
	}

	.phase .out {
		position: absolute;
		inset: 0;
	}

	.phase .in {
		animation: show-in 10s linear infinite;
	}

	.phase .out {
		animation: show-out 10s linear infinite;
	}

	@keyframes show-in {
		0%,
		46% {
			opacity: 1;
		}
		50%,
		96% {
			opacity: 0;
		}
		100% {
			opacity: 1;
		}
	}

	@keyframes show-out {
		0%,
		46% {
			opacity: 0;
		}
		50%,
		96% {
			opacity: 1;
		}
		100% {
			opacity: 0;
		}
	}

	/* Méthode 365 */
	.method {
		padding: 72px 0 24px;
		text-align: center;
	}

	.method h2,
	.sessions h2,
	.free h2,
	.faq h2 {
		font-size: clamp(32px, 4.4vw, 52px);
		line-height: 1.04;
	}

	.figures {
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: 16px;
		margin: 48px auto 32px;
		max-width: 860px;
	}

	.figures div {
		padding: 32px 16px;
		background: var(--card);
		border-radius: 22px;
	}

	.figures strong {
		display: block;
		font-size: clamp(72px, 10vw, 120px);
		font-weight: 800;
		line-height: 1;
		letter-spacing: -0.05em;
		color: var(--primary);
		font-variant-numeric: tabular-nums;
	}

	.figures span {
		font-weight: 600;
		color: var(--text-soft);
	}

	.method-text {
		max-width: 34em;
		margin: 0 auto;
		color: var(--text-soft);
	}

	/* Captures */
	.shots {
		margin-top: 72px;
		padding: 56px 0;
		background: linear-gradient(160deg, #6f60ff, var(--primary) 55%, #4a3be0);
	}

	.shots-track {
		display: flex;
		gap: 20px;
		overflow-x: auto;
		scroll-snap-type: x mandatory;
		padding: 0 max(24px, calc((100vw - 1120px) / 2));
		scrollbar-width: none;
	}

	.shots-track::-webkit-scrollbar {
		display: none;
	}

	.shots-track img {
		flex: 0 0 auto;
		width: clamp(220px, 24vw, 290px);
		height: auto;
		border-radius: 22px;
		scroll-snap-align: center;
	}

	/* Séances */
	.sessions {
		padding-top: 96px;
	}

	.session-list {
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: 16px;
		list-style: none;
		margin: 40px 0 0;
		padding: 0;
	}

	.session-list li {
		display: flex;
		flex-direction: column;
		gap: 6px;
		padding: 24px;
		border-radius: 22px;
		background: #1a1a21;
		color: #f3f3f6;
		min-height: 220px;
	}

	.session-icon {
		display: grid;
		place-items: center;
		width: 52px;
		height: 52px;
		border-radius: 14px;
		margin-bottom: auto;
		color: #fff;
	}

	.session-icon svg {
		width: 26px;
		height: 26px;
	}

	.tone-warm .session-icon {
		background: #e98a3c;
	}

	.tone-teal .session-icon {
		background: #2f8b99;
	}

	.tone-night .session-icon {
		background: #4b4794;
	}

	.session-when {
		margin-top: 28px;
		font-size: 11px;
		font-weight: 800;
		letter-spacing: 0.12em;
		text-transform: uppercase;
		color: #9aa0ac;
	}

	.session-list h3 {
		font-size: 24px;
	}

	.chips {
		display: flex;
		gap: 6px;
		margin-top: 6px;
	}

	.chips span {
		padding: 3px 10px;
		border-radius: 999px;
		background: rgba(255, 255, 255, 0.09);
		font-size: 13px;
		font-weight: 600;
	}

	/* Fonctionnalités */
	.features {
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: 0 48px;
		padding-top: 72px;
	}

	.features article {
		padding: 24px 0;
		border-top: 1px solid var(--line);
	}

	.features h3 {
		font-size: 19px;
		letter-spacing: -0.02em;
		margin-bottom: 6px;
	}

	.features p {
		margin: 0;
		color: var(--text-soft);
		font-size: 16px;
	}

	/* Gratuit */
	.free {
		margin-top: 80px;
		background: linear-gradient(180deg, #211c4a, #151134 62%, var(--night));
		color: #f3f3f6;
	}

	.free-inner {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 48px;
		align-items: center;
		padding: 88px 0;
	}

	.free .kicker {
		color: #a99fff;
	}

	.free h2 em {
		color: #fbbf77;
	}

	.free ul {
		list-style: none;
		margin: 0;
		padding: 0;
	}

	.free li {
		display: flex;
		gap: 12px;
		align-items: center;
		padding: 14px 0;
		border-bottom: 1px solid rgba(255, 255, 255, 0.08);
		font-weight: 600;
	}

	.free li::before {
		content: '✓';
		display: grid;
		place-items: center;
		flex: 0 0 26px;
		height: 26px;
		border-radius: 50%;
		background: #7b6bff;
		color: #fff;
		font-size: 14px;
	}

	.free-note {
		margin: 20px 0 0;
		font-size: 15px;
		color: #9aa0ac;
	}

	/* FAQ */
	.faq {
		max-width: 820px;
		padding-top: 96px;
	}

	.faq h2 {
		margin-bottom: 24px;
	}

	.faq details {
		border-bottom: 1px solid var(--line);
	}

	.faq summary {
		display: flex;
		justify-content: space-between;
		gap: 24px;
		padding: 20px 0;
		font-size: 18px;
		font-weight: 700;
		cursor: pointer;
		list-style: none;
	}

	.faq summary::-webkit-details-marker {
		display: none;
	}

	.faq summary::after {
		content: '+';
		flex: 0 0 28px;
		height: 28px;
		display: grid;
		place-items: center;
		border-radius: 50%;
		background: var(--primary-soft);
		color: var(--primary);
		font-weight: 700;
		transition: transform 0.2s ease;
	}

	.faq details[open] summary::after {
		transform: rotate(45deg);
	}

	.faq p {
		margin: 0 0 22px;
		color: var(--text-soft);
	}

	/* Appel final */
	.cta {
		margin-top: 96px;
