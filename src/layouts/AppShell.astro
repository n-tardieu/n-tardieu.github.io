---
// Mini-site d'une app, à la manière des sites d'apps de Chris Raroque : un menu
// propre à l'app (Fonctionnalités · Tarifs · Guides · À propos) et un bouton
// Télécharger toujours visible, un pied de page avec l'aide et les autres apps.
// Le thème (couleurs, typographie, coins) suit l'identité de l'app.
import Base from './Base.astro';
import Reveal from '../components/Reveal.astro';
import { APPS, appPages, getApp, waitlistHref } from '../data/apps';
import '../styles/frame.css';

interface Props {
	app: 'coheria' | 'eau-et-cafe';
	title: string;
	description: string;
	image?: string;
	jsonLd?: Record<string, unknown>;
	/** Le haut de page porte son propre fond (hero) : l'en-tête reste transparent. */
	overHero?: boolean;
}

const { app: slug, title, description, image, jsonLd, overHero = false } = Astro.props;
const app = getApp(slug);
const pages = appPages(app);
const path = Astro.url.pathname.endsWith('/') ? Astro.url.pathname : `${Astro.url.pathname}/`;
const waitlist = waitlistHref(app);
const hasStore = Boolean(app.stores.ios || app.stores.android);
const others = APPS.filter((a) => a.slug !== slug);
const fonts =
	slug === 'eau-et-cafe' ? 'family=Archivo:wght@400;500;600;700;800&family=Archivo+Narrow:wght@500;600;700' : undefined;
---

<Base
	title={title}
	description={description}
	image={image}
	iosAppId={app.stores.iosId}
	themeColor={slug === 'coheria' ? '#FCE3CE' : '#F5F4EF'}
	favicon={app.icon}
	fonts={fonts}
	jsonLd={jsonLd}
>
	<div class={`site theme-${slug}`}>
		<header class:list={['app-bar', { 'over-hero': overHero }]}>
			<div class="bar-inner">
				<a href={`/${slug}/`} class="brand">
					<img src={app.icon} alt="" width="32" height="32" />
					<span>{app.name}</span>
				</a>
				<nav aria-label={`Navigation ${app.name}`}>
					{
						pages.map((p) => (
							<a href={p.href} aria-current={path.startsWith(p.href) ? 'page' : undefined}>
								{p.label}
							</a>
						))
					}
				</nav>
				{
					hasStore ? (
						<a href={`/${slug}/telecharger/`} class="download">
							Télécharger
						</a>
					) : (
						waitlist && (
							<a href={waitlist} class="download">
								Me prévenir
							</a>
						)
					)
				}
			</div>
		</header>

		<slot />

		<footer class="app-footer">
			<div class="cols">
				<div class="about-col">
					<a href={`/${slug}/`} class="brand">
						<img src={app.icon} alt="" width="32" height="32" />
						<span>{app.name}</span>
					</a>
					<p>{app.tagline}</p>
				</div>
				<div>
					<p class="head">{app.name}</p>
					{pages.map((p) => <a href={p.href}>{p.label}</a>)}
				</div>
				<div>
					<p class="head">Aide</p>
					<a href={app.support}>Assistance</a>
					<a href={app.privacy}>Confidentialité</a>
					<a href={`mailto:${app.contact}`}>Écrire</a>
				</div>
				<div>
					<p class="head">Mes autres apps</p>
					{others.map((a) => <a href={`/${a.slug}/`}>{a.name}</a>)}
					<a href="/">Fait par Nicolas Tardieu</a>
				</div>
			</div>
			<p class="legal">
				{app.name} est une application de bien-être, pas un dispositif médical. © {new Date().getFullYear()} Nicolas
				Tardieu.
			</p>
		</footer>
	</div>
	<Reveal />
	{
		slug === 'coheria' && (
			<script>
				// En-tête de Coheria au défilement, comme dans une app mobile : il est
				// « poussé » par le contenu (il monte exactement de la distance défilée) et
				// redescend de même quand on remonte. Arrêté à mi-course, il finit son
				// mouvement vers le côté le plus proche. Une fois la colline passée, il
				// quitte le pêche pour un blanc translucide.
				const bar = document.querySelector<HTMLElement>('.app-bar');
				if (bar && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
					const hero = document.querySelector<HTMLElement>('.hero');
					let last = Math.max(0, scrollY);
					let offset = 0;
					let frame = 0;
					let settle = 0;

					const place = (animate = false) => {
						bar.style.transition = animate ? 'transform 0.22s cubic-bezier(0.2, 0.7, 0.2, 1)' : '';
						bar.style.transform = offset ? `translate3d(0, ${offset}px, 0)` : '';
					};

					const update = () => {
						frame = 0;
						const y = Math.max(0, scrollY);
						const h = bar.offsetHeight;
						bar.classList.toggle('is-past', y > (hero ? hero.offsetHeight - h : 80));
						// Suit le défilement, sans jamais découvrir le haut de la page.
						offset = Math.min(0, Math.max(-h, offset - (y - last), -y));
						last = y;
						place();
						clearTimeout(settle);
						settle = window.setTimeout(() => {
							if (offset === 0 || offset === -h) return;
							offset = offset < -h / 2 && y > h ? -h : 0;
							place(true);
						}, 120);
					};

					addEventListener('scroll', () => (frame ||= requestAnimationFrame(update)), { passive: true });
					update();
				} else if (bar) {
					const hero = document.querySelector<HTMLElement>('.hero');
					const update = () => bar.classList.toggle('is-past', scrollY > (hero ? hero.offsetHeight - bar.offsetHeight : 80));
					addEventListener('scroll', update, { passive: true });
					update();
				}
			</script>
		)
	}
</Base>

<style>
	.app-bar {
		position: sticky;
		top: 0;
		z-index: 20;
		background: var(--header-bg);
		border-bottom: 1px solid var(--line);
	}

	.app-bar.over-hero {
		border-bottom-color: transparent;
	}

	/* Coheria : l'en-tête quitte le pêche une fois la colline passée (voir le script). */
	.theme-coheria .app-bar {
		will-change: transform;
		transition:
			background 0.3s ease,
			border-color 0.3s ease;
	}

	.theme-coheria .app-bar.is-past {
		background: rgba(255, 255, 255, 0.82);
		-webkit-backdrop-filter: saturate(1.4) blur(14px);
		backdrop-filter: saturate(1.4) blur(14px);
		border-bottom-color: var(--line);
	}


	.theme-eau-et-cafe .app-bar {
		border-bottom: 2px solid var(--ink);
	}

	.bar-inner {
		display: flex;
		align-items: center;
		gap: 24px;
		width: min(1132px, calc(100% - 32px));
		height: 64px;
		margin: 0 auto;
	}

	.brand {
		display: flex;
		align-items: center;
		gap: 10px;
		font-size: 18px;
		font-weight: 800;
		letter-spacing: -0.02em;
		text-decoration: none;
		white-space: nowrap;
	}

	.brand img {
		border-radius: 8px;
	}

	.theme-eau-et-cafe .brand span {
		font-family: var(--narrow);
		font-weight: 700;
		text-transform: uppercase;
		letter-spacing: 0.02em;
	}

	nav {
		display: flex;
		gap: 22px;
		margin-left: auto;
	}

	nav a {
		font-size: 15px;
		font-weight: 600;
		color: var(--ink-2);
		text-decoration: none;
	}

	nav a:hover,
	nav a[aria-current='page'] {
		color: var(--ink);
	}

	.download {
		padding: 9px 16px;
		border-radius: var(--radius);
		background: var(--accent);
		color: var(--accent-ink);
		font-size: 15px;
		font-weight: 700;
		text-decoration: none;
		white-space: nowrap;
		transition: transform 0.2s ease;
	}

	.theme-coheria .download {
		border-radius: 999px;
	}

	.download:hover {
		transform: translateY(-1px);
	}

	.app-footer {
		width: min(1132px, calc(100% - 32px));
		margin: 96px auto 0;
		padding: 32px 0 40px;
		border-top: 1px solid var(--line);
		font-size: 14px;
	}

	.theme-eau-et-cafe .app-footer {
		border-top: 2px solid var(--ink);
	}

	.cols {
		display: grid;
		grid-template-columns: 1.4fr 1fr 1fr 1fr;
		gap: 24px;
	}

	.cols > div {
		display: flex;
		flex-direction: column;
		gap: 6px;
	}

	.about-col p {
		max-width: 22em;
		margin: 8px 0 0;
		color: var(--ink-2);
	}

	.head {
		margin: 0 0 4px;
		font-size: 12px;
		font-weight: 700;
		letter-spacing: 0.12em;
		text-transform: uppercase;
	}

	.cols a:not(.brand) {
		color: var(--ink-2);
		text-decoration: none;
	}

	.cols a:not(.brand):hover {
		color: var(--ink);
		text-decoration: underline;
	}

	.legal {
		margin: 32px 0 0;
		font-size: 12px;
		color: var(--ink-2);
	}

	@media (max-width: 820px) {
		.bar-inner {
			flex-wrap: wrap;
			height: auto;
			gap: 0 16px;
			padding-top: 12px;
		}

		.download {
			margin-left: auto;
			padding: 7px 14px;
			font-size: 14px;
		}

		nav {
			order: 3;
			width: 100%;
			margin: 0;
			padding: 10px 0 12px;
			overflow-x: auto;
			scrollbar-width: none;
		}

		nav::-webkit-scrollbar {
			display: none;
		}

		nav a {
			white-space: nowrap;
		}

		.cols {
			grid-template-columns: 1fr 1fr;
		}

		.about-col {
			grid-column: 1 / -1;
		}
	}
</style>
