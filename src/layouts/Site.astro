---
// Cadre du site (hub, guides, outils, à propos) : papier et encre, Archivo.
// Les pages d'app gardent leur propre identité et n'utilisent pas ce cadre.
import Base from './Base.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';

interface Props {
	title: string;
	description: string;
	image?: string;
	iosAppId?: string | null;
	jsonLd?: Record<string, unknown>;
}

const props = Astro.props;
---

<Base
	{...props}
	themeColor="#F5F4EF"
	fonts="family=Archivo:wght@400;500;600;700;800&family=Archivo+Narrow:wght@500;600;700"
>
	<div class="site">
		<SiteHeader />
		<slot />
		<SiteFooter />
	</div>
</Base>

<style is:global>
	.site {
		--paper: #f5f4ef;
		--paper-2: #edebe4;
		--ink: #0e0e0e;
		--ink-2: #55544f;
		--line: #c9c7be;
		--sans: 'Archivo', system-ui, sans-serif;
		--narrow: 'Archivo Narrow', 'Archivo', system-ui, sans-serif;

		min-height: 100vh;
		background: var(--paper);
		color: var(--ink);
		font-family: var(--sans);
		font-size: 17px;
		line-height: 1.6;
	}

	.site a {
		color: inherit;
	}

	.site .wrap {
		width: min(1132px, calc(100% - 32px));
		margin: 0 auto;
	}

	.site .label {
		display: block;
		font-size: 12px;
		font-weight: 700;
		letter-spacing: 0.12em;
		text-transform: uppercase;
	}

	/* Outils : panneau de saisie et résultat */
	.site .tool {
		display: grid;
		grid-template-columns: 1fr 1fr;
		margin: 32px 0 8px;
		border: 2px solid var(--ink);
		background: #fbfaf6;
	}

	.site .tool-form {
		display: grid;
		gap: 22px;
		padding: 28px;
		border-right: 1px solid var(--line);
	}

	.site .tool-result {
		display: flex;
		flex-direction: column;
		justify-content: center;
		padding: 28px;
	}

	.site .field > span,
	.site .field legend {
		display: block;
		margin-bottom: 8px;
		padding: 0;
		font-size: 12px;
		font-weight: 700;
		letter-spacing: 0.1em;
		text-transform: uppercase;
	}

	.site fieldset.field {
		margin: 0;
		padding: 0;
		border: 0;
	}

	.site .field input[type='time'],
	.site .field input[type='number'] {
		width: 100%;
		padding: 10px 12px;
		border: 1.5px solid var(--ink);
		border-radius: 0;
		background: #fff;
		color: var(--ink);
		font-family: var(--narrow);
		font-size: 26px;
		font-weight: 600;
	}

	.site .segmented {
		display: flex;
		flex-wrap: wrap;
	}

	.site .segmented label {
		flex: 1 1 0;
		min-width: 0;
		cursor: pointer;
	}

	.site .segmented input {
		position: absolute;
		opacity: 0;
		pointer-events: none;
	}

	.site .segmented span {
		display: block;
		height: 100%;
		margin-left: -1.5px;
		padding: 10px 8px;
		border: 1.5px solid var(--ink);
		text-align: center;
		font-size: 14px;
		font-weight: 600;
		line-height: 1.25;
	}

	.site .segmented label:first-child span {
		margin-left: 0;
	}

	.site .segmented small {
		display: block;
		font-weight: 400;
		color: var(--ink-2);
	}

	.site .segmented input:checked + span {
		background: var(--ink);
		color: var(--paper);
	}

	.site .segmented input:checked + span small {
		color: rgba(245, 244, 239, 0.7);
	}

	.site .segmented input:focus-visible + span {
		outline: 2px solid var(--ink);
		outline-offset: 2px;
	}

	.site .result-figure {
		margin: 4px 0 8px;
		font-family: var(--narrow);
		font-size: clamp(72px, 10vw, 112px);
		font-weight: 600;
		line-height: 0.9;
		font-variant-numeric: tabular-nums;
	}

	.site .result-figure small {
		font-size: 0.35em;
	}

	.site .result-text {
		margin: 0;
		color: var(--ink-2);
	}

	@media (max-width: 720px) {
		.site .tool {
			grid-template-columns: 1fr;
		}

		.site .tool-form {
			border-right: 0;
			border-bottom: 1px solid var(--line);
			padding: 20px;
		}

		.site .tool-result {
			padding: 20px;
		}
	}

	.site .display {
		font-family: var(--narrow);
		font-weight: 700;
		line-height: 0.95;
		text-transform: uppercase;
		letter-spacing: -0.005em;
	}
</style>
