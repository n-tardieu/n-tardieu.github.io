---
// Cadre du site perso (accueil, à propos, journal) : papier et encre, Archivo.
// Les pages d'app utilisent AppShell, aux couleurs de chaque app.
import Base from './Base.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import Reveal from '../components/Reveal.astro';
import '../styles/frame.css';

interface Props {
	title: string;
	description: string;
	image?: string;
	iosAppId?: string | null;
	jsonLd?: Record<string, unknown>;
	noindex?: boolean;
}

const props = Astro.props;
---

<Base
	{...props}
	themeColor="#F5F4EF"
	fonts="family=Archivo:wght@400;500;600;700;800&family=Archivo+Narrow:wght@500;600;700"
>
	<div class="site">
		<SiteHeader />
		<slot />
		<SiteFooter />
	</div>
	<Reveal />
</Base>
